import <iter_adapters>;
struct Counter { value: i32, drop_ptr: *rw i32 };
impl std::Drop for Counter {
    fn drop(self: &rw Self) { unsafe { *self.drop_ptr = *self.drop_ptr + 1; } }
}
impl std::iter::Step for Counter {
    fn step_forward(self: &Self) -> Self { return Counter { value: self.value + 1, drop_ptr: self.drop_ptr }; }
    fn step_less(self: &Self, other: &Self) -> bool { return self.value < other.value; }
    fn step_eq(self: &Self, other: &Self) -> bool { return self.value == other.value; }
    fn step_greater(self: &Self, other: &Self) -> bool { return self.value > other.value; }
}

fn noncopy(drop_ptr: *rw i32) -> i32 {
    dec rw values = std::iter::range_inclusive(Counter { value: 2147483646i32, drop_ptr: drop_ptr }, Counter { value: 2147483647i32, drop_ptr: drop_ptr });
    {
        dec first = values.next();
        match first { std::Option::Some(v) -> { if v.value != 2147483646i32 { return 1; } }, std::Option::None -> { return 2; }, }
    }
    {
        dec last = values.next();
        match last { std::Option::Some(v) -> { if v.value != 2147483647i32 { return 3; } }, std::Option::None -> { return 4; }, }
    }
    match values.next() { std::Option::Some(v) -> { return 5; }, std::Option::None -> {}, }
    match values.next() { std::Option::Some(v) -> { return 6; }, std::Option::None -> {}, }
    return 0;
}

fn main() -> i32 {
    dec rw drops = 0;
    if noncopy(&rw drops) != 0 { return 1; }
    if drops != 3 { return 2; }
    return 0;
}
