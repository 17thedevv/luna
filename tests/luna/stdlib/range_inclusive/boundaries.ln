import <iter_adapters>;
// Native target: 64-bit usize/isize. All ten existing Step implementations.

fn edges_u8() -> i32 {
    dec rw upper = std::iter::range_inclusive(254u8, 255u8);
    match upper.next() { std::Option::Some(v) -> { if v != 254u8 { return 1; } }, std::Option::None -> { return 2; }, }
    match upper.next() { std::Option::Some(v) -> { if v != 255u8 { return 3; } }, std::Option::None -> { return 4; }, }
    if upper.next().is_some() { return 5; }
    if upper.next().is_some() { return 6; }
    if upper.current.is_some() { return 7; }
    if upper.exhausted == false { return 8; }
    dec rw singleton = std::iter::range_inclusive(255u8, 255u8);
    match singleton.next() { std::Option::Some(v) -> { if v != 255u8 { return 9; } }, std::Option::None -> { return 10; }, }
    if singleton.next().is_some() { return 11; }
    dec rw lower = std::iter::range_inclusive(0u8, 1u8);
    match lower.next() { std::Option::Some(v) -> { if v != 0u8 { return 12; } }, std::Option::None -> { return 13; }, }
    match lower.next() { std::Option::Some(v) -> { if v != 1u8 { return 14; } }, std::Option::None -> { return 15; }, }
    if lower.next().is_some() { return 16; }
    dec rw inverted = std::iter::range_inclusive(2u8, 1u8);
    if inverted.next().is_some() { return 17; }
    if inverted.next().is_some() { return 18; }
    dec rw direct = std::iter::RangeInclusive<u8> { current: std::Option::Some(1u8), end: 2u8, exhausted: false };
    if direct.next().unwrap() != 1u8 { return 19; }
    if direct.next().unwrap() != 2u8 { return 20; }
    if direct.next().is_some() { return 21; }
    dec rw empty_slot = std::iter::RangeInclusive<u8> { current: std::Option::None, end: 2u8, exhausted: false };
    if empty_slot.next().is_some() { return 22; }
    dec rw exclusive = std::iter::range(254u8, 255u8);
    if exclusive.next().unwrap() != 254u8 { return 23; }
    if exclusive.next().is_some() { return 24; }
    return 0;
}

