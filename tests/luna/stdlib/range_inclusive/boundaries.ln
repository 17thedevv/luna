fn main() -> i32 {
    if edges_u8() != 0 { return 1; }
    if edges_u16() != 0 { return 2; }
    if edges_u32() != 0 { return 3; }
    if edges_u64() != 0 { return 4; }
    if edges_usize() != 0 { return 5; }
    if edges_i8() != 0 { return 6; }
    if edges_i16() != 0 { return 7; }
    if edges_i32() != 0 { return 8; }
    if edges_i64() != 0 { return 9; }
    if edges_isize() != 0 { return 10; }
    return 0;
}
