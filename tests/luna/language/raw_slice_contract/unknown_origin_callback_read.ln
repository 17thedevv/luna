import <mem>;
unsafe fn read(pointer: *i32) -> i32 { return *pointer; }
fn inspect(pointer: *rw i32, callback: unsafe fn(*i32) -> i32) -> i32 {
    unsafe {
        dec slice = std::mem::slice_from_raw_parts<i32>(pointer as *i32, 1 as u64);
        dec value = callback(pointer as *i32);
        return value + slice[0];
    }
}
fn main() -> i32 {
    dec rw value = 7;
    return inspect(&rw value as *rw i32, read) - 14;
}
