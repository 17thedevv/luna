import <mem>;
unsafe fn write(pointer: *rw i32) { *pointer = 9; }
unsafe fn apply(pointer: *rw i32, action: unsafe fn(*rw i32) -> void) { action(pointer); }
fn bad(pointer: *rw i32, callback: unsafe fn(*rw i32, unsafe fn(*rw i32) -> void) -> void, action: unsafe fn(*rw i32) -> void) -> i32 {
    unsafe {
        dec slice = std::mem::slice_from_raw_parts<i32>(pointer as *i32, 1 as u64);
        callback(pointer, action);
        return slice[0];
    }
}
fn main() { dec rw value = 7; bad(&rw value as *rw i32, apply, write); }
