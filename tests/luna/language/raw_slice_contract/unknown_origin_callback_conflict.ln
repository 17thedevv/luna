import <mem>;
unsafe fn write(pointer: *rw i32) { *pointer = 9; }
fn bad(pointer: *rw i32, callback: unsafe fn(*rw i32) -> void) -> i32 {
    unsafe {
        dec slice = std::mem::slice_from_raw_parts<i32>(pointer as *i32, 1 as u64);
        callback(pointer);
        return slice[0];
    }
}
fn main() { dec rw value = 7; bad(&rw value as *rw i32, write); }
