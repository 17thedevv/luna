import "provider";
fn main() -> i32 {
    dec rw count = 0;
    dec counter = &rw count as *rw i32;
    {
        dec owned = named::Owned { counter: counter, value: 9 };
        named::consume(marker=2, value=owned);
        if count != 1 { return 1; }
        named::consume(marker=2, value=named::Owned { counter: counter, value: 7 });
        if count != 2 { return 2; }
    }
    return count - 2;
}
