import "resource";
fn main() -> i32 {
    dec rw count = 0;
    dec counter = &rw count as *rw i32;
    {
        resources::consume(resources::Envelope { value: resources::tracked(counter, 1) });
        if count != 1 { return 1; }
        resources::consume(resources::Envelope {
            value: resources::Envelope { value: resources::tracked(counter, true) }
        });
        if count != 2 { return 2; }
        resources::consume((resources::tracked(counter, 3), resources::tracked(counter, false)));
        if count != 4 { return 3; }
        resources::consume([resources::tracked(counter, 5), resources::tracked(counter, 6)]);
        if count != 6 { return 4; }
        resources::consume(resources::Choice::One(resources::tracked(counter, 7)));
        if count != 7 { return 5; }
        dec empty: resources::Choice<resources::Tracked<i32>> = resources::Choice::Empty;
        resources::consume(empty);
        if count != 7 { return 6; }
    }
    if count != 7 { return 7; }
    {
        dec empty: [resources::Tracked<i32>; 0] = [];
        resources::consume(empty);
        if count != 7 { return 8; }
        resources::consume([resources::tracked(counter, true), resources::tracked(counter, false)]);
        if count != 9 { return 9; }
        dec first: resources::Mixed<resources::Tracked<i32>, resources::Tracked<bool>> =
            resources::Mixed::First(resources::tracked(counter, 30));
        resources::consume(first);
        if count != 10 { return 10; }
        resources::consume(resources::Mixed::Pair(resources::tracked(counter, 40), resources::tracked(counter, true)));
        if count != 12 { return 11; }
        dec vacant: resources::Mixed<resources::Tracked<bool>, resources::Tracked<i32>> = resources::Mixed::Empty;
        resources::consume(vacant);
        if count != 12 { return 12; }
    }
    if count != 12 { return 13; }
    return 0;
}
