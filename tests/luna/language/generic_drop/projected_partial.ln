import "resource";
fn main() -> i32 {
    dec rw count = 0;
    dec counter = &rw count as *rw i32;
    {
        dec split = resources::Split {
            first: resources::tracked(counter, 1),
            second: resources::tracked(counter, 2),
        };
        dec f = split.first;
        dec seen = split.second.value;
        if seen != 2 { return 9; }
        resources::consume(f);
    }
    // f consumed (1) + remaining second dropped once (1) = 2.
    if count != 2 { return count; }
    return 0;
}
