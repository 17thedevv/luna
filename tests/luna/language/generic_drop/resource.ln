export module resources {
    export struct Tracked<T> { value: T, counter: *rw i32, };
    impl<T> std::Drop for Tracked<T> {
        fn drop(&rw self) {
            unsafe { *self.counter = *self.counter + 1; }
        }
    }
    export fn tracked<T>(counter: *rw i32, value: T) -> Tracked<T> {
        return Tracked<T> { value: value, counter: counter };
    }
    export struct Envelope<T> { value: T, };
    export struct Split<A, B> { first: A, second: B, };
    export fn split_first<A, B>(pair: Split<A, B>) -> A {
        return pair.first;
    }
    export fn split_second<A, B>(pair: Split<A, B>) -> B {
        pair.second
    }
    export struct Trace<T> { value: T, tag: i32, log: *rw i32, };
    impl<T> std::Drop for Trace<T> {
        fn drop(&rw self) {
            unsafe { *self.log = *self.log * 10 + self.tag; }
        }
    }
    impl<T> Envelope<T> {
        export fn pair<U>(self, other: U) -> (Self, U) {
            return (self, other);
        }
    }
    export struct Owner<T> { value: T, counter: *rw i32, };
    impl<T> std::Drop for Owner<T> {
        fn drop(&rw self) {
            unsafe { *self.counter = *self.counter + 1; }
        }
    }
    export enum Choice<T> { One(T), Empty, }
    export enum Mixed<A, B> { First(A), Pair(A, B), Empty, }
    export fn consume<T>(value: T) {}
    export fn identity<T>(value: T) -> T { return value; }
    export fn branch<T>(value: T, flag: bool) {
        if flag { consume(value); } else { consume(value); }
    }
    export fn early<T>(value: T, flag: bool) {
        if flag { return; }
    }
    export fn conditional<T>(value: T, flag: bool) {
        dec rw slot: T;
        if flag { slot = value; }
    }
    export fn reinitialize<T>(value: T, replacement: T, flag: bool) {
        dec rw current = value;
        if flag { consume(current); }
        current = replacement;
    }
    export unsafe fn raw_initialize<T>(destination: *rw T, value: T) {
        *destination = value;
    }
    export fn replace_borrowed<T>(destination: &rw T, value: T) {
        *destination = value;
    }
}
