import "resource";
fn main() -> i32 {
    dec rw count = 0;
    dec counter = &rw count as *rw i32;
    {
        // The closure owns the captured value but never consumes it. Calling it
        // must destroy the capture exactly once through the invocation epilogue.
        dec value = resources::tracked(counter, 42);
        dec f = move || {
            dec r = &value;
            return 0;
        };
        dec out = f();
        if out != 0 { return 1; }
    }
    if count != 1 { return 2; }
    return 0;
}
