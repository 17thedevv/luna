import "resource";
fn main() -> i32 {
    dec rw count = 0;
    dec counter = &rw count as *rw i32;
    dec rw i = 0;
    while i < 3 {
        dec owned = resources::identity(resources::tracked(counter, i));
        i = i + 1;
        if i == 1 { continue; }
        if i == 2 { break; }
    }
    if count != 2 { return 1; }
    return 0;
}
