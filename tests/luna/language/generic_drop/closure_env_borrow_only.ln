import "resource";
fn main() -> i32 {
    dec rw count = 0;
    dec counter = &rw count as *rw i32;
    {
        dec value = resources::tracked(counter, 42);
        // Borrow-only capture: calling must not consume the closure or the
        // pointee; the owning local still drops the value at scope exit.
        dec f = || {
            dec r = &value;
            return 0;
        };
        dec out = f();
        if out != 0 { return 1; }
    }
    if count != 1 { return 2; }
    return 0;
}
