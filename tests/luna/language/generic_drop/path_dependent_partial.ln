import "resource";
fn main() -> i32 {
    dec rw count = 0;
    dec counter = &rw count as *rw i32;
    dec flag = false;
    {
        dec split = resources::Split {
            first: resources::tracked(counter, 1),
            second: resources::tracked(counter, 2),
        };
        if flag {
            dec f = split.first;
            resources::consume(f);
        }
    }
    // flag == false: both fields still owned -> each dropped once (2).
    if count != 2 { return count; }
    return 0;
}
