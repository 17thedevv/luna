import "resource";
fn main() -> i32 {
    dec rw count = 0;
    dec counter = &rw count as *rw i32;
    resources::reinitialize(resources::tracked(counter, 1), resources::tracked(counter, 2), true);
    if count != 2 { return 1; }
    resources::reinitialize(resources::tracked(counter, true), resources::tracked(counter, false), false);
    if count != 4 { return 2; }
    {
        dec rw slot: resources::Tracked<i32>;
        dec rw index = 0;
        while index < 3 {
            if index == 1 { slot = resources::tracked(counter, 10); }
            index = index + 1;
        }
    }
    if count != 5 { return 3; }
    return 0;
}
