import "resource";
fn main() -> i32 {
    dec rw count = 0;
    dec counter = &rw count as *rw i32;
    {
        dec m = resources::Mixed::Pair(
            resources::tracked(counter, 1),
            resources::tracked(counter, 2));
        match m {
            resources::Mixed::Pair(a, b) -> {
                resources::consume(a);
            },
            resources::Mixed::First(a) -> {
                resources::consume(a);
            },
            resources::Mixed::Empty -> {},
        }
    }
    // a consumed (1) + remaining payload b dropped exactly once (1) = 2.
    if count != 2 { return count; }
    return 0;
}
