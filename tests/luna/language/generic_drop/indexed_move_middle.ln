import "resource";
fn main() -> i32 {
    dec rw count = 0;
    dec counter = &rw count as *rw i32;
    {
        dec arr = [
            resources::tracked(counter, 1),
            resources::tracked(counter, 2),
            resources::tracked(counter, 3)];
        resources::consume(arr[1]);
    }
    // arr[1] consumed (1) + remaining arr[0] and arr[2] dropped (2) = 3.
    if count != 3 { return count; }
    return 0;
}
