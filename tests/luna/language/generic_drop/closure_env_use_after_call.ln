import "resource";
fn main() -> i32 {
    dec rw count = 0;
    dec counter = &rw count as *rw i32;
    dec value = resources::tracked(counter, 42);
    dec f = move || {
        resources::consume(value);
        return 0;
    };
    dec a = f();
    // Using the consumed closure value afterwards must be use-after-move.
    dec g = f;
    return 0;
}
