import "resource";
fn main() -> i32 {
    dec rw count = 0;
    dec counter = &rw count as *rw i32;
    dec value = resources::tracked(counter, 42);
    dec f = move || {
        resources::consume(value);
        return 0;
    };
    dec a = f();
    // A closure owning an owned capture is one-shot: the second call must be
    // rejected as use-after-move, not executed at runtime.
    dec b = f();
    return 0;
}
