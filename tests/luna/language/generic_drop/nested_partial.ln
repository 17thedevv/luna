import "resource";
fn main() -> i32 {
    dec rw count = 0;
    dec counter = &rw count as *rw i32;
    {
        dec outer = resources::Envelope {
            value: resources::Split {
                first: resources::tracked(counter, 1),
                second: resources::tracked(counter, 2),
            },
        };
        dec f = outer.value.first;
        resources::consume(f);
    }
    // f consumed (1) + nested remaining inner.second dropped once (1) = 2.
    if count != 2 { return count; }
    return 0;
}
