import "resource";
fn main() -> i32 {
    dec rw count = 0;
    dec counter = &rw count as *rw i32;
    dec flag = false;
    dec value = resources::tracked(counter, 42);
    // The capture is only conditionally consumed; the epilogue must drop it on
    // the path that did not move it, and must not drop it on the moved path.
    dec f = move || {
        if flag { resources::consume(value); }
        return 0;
    };
    dec out = f();
    if out != 0 { return 1; }
    if count != 1 { return 2; }
    return 0;
}
