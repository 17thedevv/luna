import "resource";
fn main() -> i32 {
    dec rw count = 0;
    dec counter = &rw count as *rw i32;
    {
        dec value = resources::tracked(counter, 42);
        dec closure = move || { resources::consume(value); };
        closure();
        if count != 1 { return 1; }
    }
    if count != 1 { return 2; }
    {
        dec value = resources::tracked(counter, false);
        dec unused = move || { resources::consume(value); };
    }
    if count != 2 { return 3; }
    return 0;
}
