// LEGACY / CHARACTERIZATION: the unparenthesized head is accepted by the parser
// but is NOT standardized 0.1 syntax. Do not build stdlib or docs on this form.
import <vec>;
fn main() -> i32 {
    dec rw values = std::vec_new<i32>();
    values.push(42);
    dec rw total: i32 = 0;
    for value in values { total = total + value; }
    return total - 42;
}
