import "provider";
async fn work(v: resources::Tracked<i32>, flag: bool) -> i32 {
    if flag { resources::consume(v); }
    dec h = await resources::helper();
    return h;
}
fn main() -> i32 {
    dec rw count = 0;
    dec counter = &rw count as *rw i32;
    dec v = resources::tracked(counter, 42);
    dec fut = work(v, true);
    return 0;
}
