module first { export fn make() -> i32 { return 1; } export const VALUE: i32 = 1; }
module second { export fn make() -> i32 { return 2; } export const VALUE: i32 = 2; }
using first as selected;
using first as selected_value;
module defaults {
    fn helper(value: i32) -> i32 { return value + 20; }
    export fn combine(first: i32, second: i32 = helper(first)) -> i32 {
        return first + second;
    }
    export fn alias_default(value: i32 = selected::make()) -> i32 { return value; }
    export fn constant_default(value: i32 = selected_value::VALUE) -> i32 { return value; }
    fn generic_helper<T>(value: T) -> T { return value; }
    export fn generic_default<T>(first: T, second: T = generic_helper<T>(first)) -> T { return second; }
    export fn identity<T>(first: T, second: T = first as T) -> T { return second; }
    export fn borrowed(first: &i32, second: &i32 = first) -> i32 { return *first + *second; }
    export struct Counter { base: i32 };
    impl Counter {
        export fn add(&self, base: i32 = self.base) -> i32 { return self.base + base; }
    }
    export trait Compute { fn eval(&self, value: i32 = helper(4)) -> i32; }
    impl Compute for Counter {
        fn eval(&self, item: i32) -> i32 { return self.base + item; }
    }
    export struct Cell<T> { value: T };
    impl<T> Cell<T> {
        export fn read(&self, value: &T = &self.value as &T) -> i32 { return 0; }
    }
    export trait Processor<U> {
        fn identity(&self, first: U, second: U = first as U) -> U;
    }
    impl Processor<i32> for Counter {
        fn identity(&self, input: i32, output: i32) -> i32 { return output; }
    }
}
