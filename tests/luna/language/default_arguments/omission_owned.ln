import "provider";
fn main() -> i32 {
    dec rw drops = 0;
    dec raw = &rw drops as *rw i32;
    if (omitted::fresh(raw) != 9) { return 1; }
    if (drops != 1) { return 2; }
    if (omitted::fresh(raw) != 9) { return 3; }
    if (drops != 2) { return 4; }
    dec item = omitted::Owned { counter: raw, value: 17 };
    if (omitted::borrow_owned(item) != 17) { return 5; }
    return drops - 3;
}
