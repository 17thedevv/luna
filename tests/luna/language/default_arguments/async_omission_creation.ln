import "provider";
fn main() -> i32 {
    dec rw count = 0;
    dec pointer = &rw count as *rw i32;
    unsafe {
        {
            dec full = timing::schedule(pointer, value=7);
            if count != 0 { return 1; }
        }
        {
            dec omitted = timing::schedule(pointer);
            if count != 1 { return 2; }
        }
    }
    return count - 1;
}
