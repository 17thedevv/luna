import "provider";
const VALUE: i32 = comptime { *stored::default_ref() };
const FIELD: i32 = comptime { *stored::field_ref() };
const ELEMENT: i32 = comptime { dec array = stored::array_ref(); array[1] };
trait Sizer { type SizeType; }
struct SizedValue {};
impl Sizer for SizedValue { type SizeType = i32; }
const ARRAY_LEN: SizedValue::SizeType = 4;
fn main() -> i32 {
    if VALUE != 20 { return 1; }
    if FIELD != 42 { return 2; }
    if ELEMENT != 11 { return 3; }
    dec array: [i32; ARRAY_LEN] = [1, 2, 3, 4];
    if array[3] != 4 { return 4; }
    return 0;
}
