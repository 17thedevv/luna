import "provider";
trait LocalValue { fn value(self: &Self) -> i32; }
impl LocalValue for policy::Counter {
    fn value(self: &Self) -> i32 { return self.current + 10; }
}
fn main() -> i32 {
    dec counter = policy::Counter { current: 7 };
    if counter.value() != 7 { return 1; }
    return 0;
}
