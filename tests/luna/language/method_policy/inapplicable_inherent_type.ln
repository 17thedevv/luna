trait Fallback { fn value(self: &Self, arg: i32) -> i32; }
struct Token {};
impl Token { fn value(self: &Self, arg: bool) -> i32 { return 30; } }
impl Fallback for Token { fn value(self: &Self, arg: i32) -> i32 { return arg; } }
fn main() -> i32 {
    dec token = Token {};
    if token.value(7) != 7 { return 1; }
    return 0;
}
