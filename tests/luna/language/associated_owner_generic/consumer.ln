import "provider";
fn main() -> i32 {
    match model::Storage<u8>::create(7 as u8) {
        model::Outcome::Success(value) -> { if value.value != (7 as u8) { return 1; } },
        model::Outcome::Failure(_) -> { return 2; },
    }
    match model::Storage<i64>::create(99 as i64) {
        model::Outcome::Success(value) -> { if value.value != (99 as i64) { return 3; } },
        model::Outcome::Failure(_) -> { return 4; },
    }
    dec pair = model::Storage<u8>::pair<i64>(6 as u8, 44 as i64);
    if pair.0.value != (6 as u8) || pair.1 != (44 as i64) { return 5; }
    dec specialized = model::Pair<i32, u8>::create(8 as u8);
    if specialized.first != 9 || specialized.second != (8 as u8) { return 6; }
    dec restricted = model::Restricted<i32>::create(12);
    if restricted.value != 12 { return 7; }
    dec factory: fn(u8) -> model::Outcome<model::Storage<u8>, i32> = model::Storage<u8>::create;
    return match factory(13 as u8) {
        model::Outcome::Success(value) -> (value.value as i32) - 13,
        model::Outcome::Failure(_) -> 8,
    };
}
