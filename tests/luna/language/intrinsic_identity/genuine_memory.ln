import <ptr>;
import <mem>;
struct Tracker { counter: *rw i32, };
impl std::Drop for Tracker { fn drop(&rw self) { unsafe { *self.counter = *self.counter + 1; } } }
const DATA: [i32; 3] = [2, 3, 5];
fn opaque_view(view: unsafe fn(*i32, u64) -> &[i32], pointer: *i32) -> i32 {
    unsafe { dec slice = view(pointer, 3 as u64); return slice[2]; }
}
fn main() -> i32 {
    dec rw count = 0;
    {
        dec rw value = Tracker { counter: &rw count as *rw i32 };
        dec pointer = &rw value as *rw Tracker;
        unsafe {
            std::ptr::drop_in_place<Tracker>(pointer);
            *pointer = Tracker { counter: &rw count as *rw i32 };
        }
        if count != 1 { return 1; }
        dec destroy = std::ptr::drop_in_place<Tracker>;
        unsafe {
            destroy(pointer);
            *pointer = Tracker { counter: &rw count as *rw i32 };
        }
        if count != 2 { return 2; }
    }
    if count != 3 { return 3; }
    dec rw values = [2, 3, 5];
    dec pointer = &rw values[0] as *rw i32;
    unsafe {
        dec xs = std::mem::slice_from_raw_parts<i32>(pointer as *i32, 3 as u64);
        if xs.len != 3 as usize { return 4; }
        if xs[2] != 5 { return 5; }
        dec rw ys = std::mem::slice_from_raw_parts_mut<i32>(pointer, 3 as u64);
        ys[1] = 11;
        dec view = std::mem::slice_from_raw_parts<i32>;
        dec zs = view(pointer as *i32, 3 as u64);
        if zs[1] != 11 { return 6; }
        dec view_mut = std::mem::slice_from_raw_parts_mut<i32>;
        dec rw ws = view_mut(pointer, 3 as u64);
        ws[2] = 17;
    }
    if values[2] != 17 { return 7; }
    if opaque_view(std::mem::slice_from_raw_parts<i32>, &DATA[0] as *i32) != 5 { return 8; }
    return 0;
}
