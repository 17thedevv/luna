struct Tracker { counter: *rw i32, };
impl std::Drop for Tracker { fn drop(&rw self) { unsafe { *self.counter = *self.counter + 1; } } }
fn harmless_drop_in_place(value: *rw Tracker) -> i32 { return 13; }
fn main() -> i32 {
    dec rw count = 0;
    {
        dec rw value = Tracker { counter: &rw count as *rw i32 };
        if harmless_drop_in_place(&rw value as *rw Tracker) != 13 { return 1; }
        if count != 0 { return 2; }
    }
    if count != 1 { return 3; }
    return 0;
}
