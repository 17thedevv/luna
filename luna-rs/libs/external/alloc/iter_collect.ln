import <vec>;
import <hashmap>;
import <hashset>;
import <hash>;
import <cmp>;
import <__lang_iterator>;
import <__lang_option>;

module std {
export fn iter_collect_vec<I: std::Iterator<Item>, Item>(iter: I) -> std::Vec<Item> {
    dec rw vec = std::vec_new<Item>();
    dec rw it = iter;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            std::Option::Some(x) -> {
                vec.push(x);
            },
            std::Option::None -> {
                running = false;
            },
        }
    }
    return vec;
}

export fn iter_collect_hashset<I: std::Iterator<Item>, Item: std::Hash + std::Eq>(iter: I) -> std::HashSet<Item> {
    dec rw set = std::hashset_new<Item>();
    dec rw it = iter;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            std::Option::Some(x) -> {
                set.insert(x);
            },
            std::Option::None -> {
                running = false;
            },
        }
    }
    return set;
}

export fn iter_collect_hashmap<I: std::Iterator<(K, V)>, K: std::Hash + std::Eq, V>(iter: I) -> std::HashMap<K, V> {
    dec rw map = std::hashmap_new<K, V>();
    dec rw it = iter;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            std::Option::Some((k, v)) -> {
                map.insert(k, v);
            },
            std::Option::None -> {
                running = false;
            },
        }
    }
    return map;
}

}

