// Alloc global: runtime allocation ABI
// No source provider dependencies.

export extern fn __luna_alloc(size: usize, align: usize) -> *rw u8;
export extern fn __luna_dealloc(ptr: *rw u8, size: usize, align: usize);
export extern fn __luna_realloc(ptr: *rw u8, old_size: usize, old_align: usize, new_size: usize) -> *rw u8;

// ABI v2: caller owns valid output storage and exact live-block metadata.
export extern unsafe fn __luna_try_alloc(size: usize, align: usize, out_ptr: *rw *rw u8) -> i32;
export extern unsafe fn __luna_try_realloc(ptr: *rw u8, old_size: usize, align: usize, new_size: usize, out_ptr: *rw *rw u8) -> i32;

