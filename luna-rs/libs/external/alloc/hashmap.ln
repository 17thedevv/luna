import <__raw_table>;
import <hash>;
import <cmp>;
import <clone>;
import <default>;
import <__lang_option>;
import <__lang_iterator>;
import <__lang_into_iterator>;
import <__lang_drop>;

module std {
    export struct MapIntoIter<K, V> {
        private raw: RawTableIntoIter<K, V>,
    };

    impl<K, V> MapIntoIter<K, V> {
        export fn next(self: &rw Self) -> std::Option<(K, V)> {
            return self.raw.next();
        }
    }

    impl<K, V> std::Iterator<(K, V)> for MapIntoIter<K, V> {
        fn next(self: &rw Self) -> std::Option<(K, V)> life_from(self) {
            return self.raw.next();
        }
    }


    export struct MapIter<K, V> {
        private raw: RawTableIter<K, V>,
    };

    impl<K, V> MapIter<K, V> {
        export fn next(self: &rw Self) -> std::Option<(&K, &V)> {
            return self.raw.next_entry();
        }
    }

    impl<K, V> std::Iterator<(&K, &V)> for MapIter<K, V> {
        fn next(self: &rw Self) -> std::Option<(&K, &V)> life_from(self) {
            return self.raw.next_entry();
        }
    }

    export struct Keys<K, V> {
        private raw: RawTableIter<K, V>,
    };

    impl<K, V> Keys<K, V> {
        export fn next(self: &rw Self) -> std::Option<&K> {
            return self.raw.next_key();
        }
    }

    impl<K, V> std::Iterator<&K> for Keys<K, V> {
        fn next(self: &rw Self) -> std::Option<&K> life_from(self) {
            return self.raw.next_key();
        }
    }

    export struct Values<K, V> {
        private raw: RawTableIter<K, V>,
    };

    impl<K, V> Values<K, V> {
        export fn next(self: &rw Self) -> std::Option<&V> {
            return self.raw.next_value();
        }
    }

    impl<K, V> std::Iterator<&V> for Values<K, V> {
        fn next(self: &rw Self) -> std::Option<&V> life_from(self) {
            return self.raw.next_value();
        }
    }

    // =========================================================================
    // HashMap<K, V>: Canonical Key-Value Hash Map Collection
    //
    // Thin semantic wrapper around RawTable<K, V>.
    // =========================================================================
    export struct HashMap<K, V> {
        private table: RawTable<K, V>,
    };

    export fn hashmap_new<K, V>() -> HashMap<K, V> {
        return HashMap<K, V> {
            table: raw_table_new<K, V>(),
        };
    }

    impl<K, V> std::Default for HashMap<K, V> {
        fn default() -> Self {
            return hashmap_new<K, V>();
        }
    }

    export fn hashmap_with_capacity<K, V>(capacity: u64) -> HashMap<K, V> {
        return HashMap<K, V> {
            table: raw_table_with_capacity<K, V>(capacity),
        };
    }

    impl<K: std::Hash + std::Eq, V> HashMap<K, V> {
        export fn len(self: &Self) -> u64 {
            return self.table.len();
        }

        export fn capacity(self: &Self) -> u64 {
            return self.table.capacity();
        }

        export fn is_empty(self: &Self) -> bool {
            return self.table.is_empty();
        }

        export fn insert(self: &rw Self, key: K, val: V) -> bool {
            return self.table.insert(key, val);
        }

        export fn insert_if_absent(self: &rw Self, key: K, val: V) -> bool {
            return self.table.insert_if_absent(key, val);
        }

        export fn get_or_insert(self: &rw Self, key: K, default_val: V) -> &rw V life_from(self) {
            return self.table.get_or_insert(key, default_val);
        }

        export fn get(self: &Self, key: &K) -> std::Option<&V> life_from(self) {
            return self.table.get(key);
        }

        export fn get_mut(self: &rw Self, key: &K) -> std::Option<&rw V> life_from(self) {
            return self.table.get_mut(key);
        }

        export fn contains_key(self: &Self, key: &K) -> bool {
            return self.table.contains_key(key);
        }

        export fn remove(self: &rw Self, key: &K) -> bool {
            return self.table.remove(key);
        }

        export fn clear(self: &rw Self) {
            self.table.clear();
        }

        export fn iter(self: &Self) -> MapIter<K, V> life_from(self) {
            return MapIter<K, V> {
                raw: self.table.iter(),
            };
        }

        export fn into_iter(self: Self) -> MapIntoIter<K, V> {
            return MapIntoIter<K, V> {
                raw: raw_table_into_iter<K, V>(self.table),
            };
        }

        export fn keys(self: &Self) -> Keys<K, V> life_from(self) {
            return Keys<K, V> {
                raw: self.table.iter(),
            };
        }

        export fn values(self: &Self) -> Values<K, V> life_from(self) {
            return Values<K, V> {
                raw: self.table.iter(),
            };
        }
    }

    impl<K: std::Clone + std::Hash + std::Eq, V: std::Clone> std::Clone for HashMap<K, V> {
        fn clone(self: &Self) -> Self {
            dec rw res = hashmap_new<K, V>();
            dec rw it = self.iter();
            while true {
                dec item = it.next();
                match item {
                    std::Option::Some(pair) -> {
                        res.insert((*pair.0).clone(), (*pair.1).clone());
                    },
                    std::Option::None -> { break; },
                }
            }
            return res;
        }
    }

    impl<K: std::Hash + std::Eq, V: std::Eq> std::Eq for HashMap<K, V> {
        fn eq(self: &Self, other: &Self) -> bool {
            if self.len() != other.len() { return false; }
            dec rw it = self.iter();
            while true {
                dec item = it.next();
                match item {
                    std::Option::Some(pair) -> {
                        match other.get(pair.0) {
                            std::Option::Some(other_val) -> {
                                if *pair.1 != *other_val {
                                    return false;
                                }
                            },
                            std::Option::None -> {
                                return false;
                            },
                        }
                    },
                    std::Option::None -> { break; },
                }
            }
            return true;
        }
    }

}

impl<K, V> std::IntoIterator<(K, V), std::MapIntoIter<K, V>> for std::HashMap<K, V> {
    fn into_iter(self: Self) -> std::MapIntoIter<K, V> {
        return self.into_iter();
    }
}

extern fn __luna_panic_default();
