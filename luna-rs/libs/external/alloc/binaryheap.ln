import <vec>;
import <slice>;
import <cmp>;
import <clone>;
import <default>;
import <__lang_drop>;
import <__lang_option>;
import <__lang_iterator>;
import <__lang_into_iterator>;

module std {

export type BinaryHeapIter<T> = std::slice::SliceIter<T>;

export struct BinaryHeapIntoIter<T> {
    private vec_iter: std::VecIntoIter<T>,
};

impl<T> BinaryHeapIntoIter<T> {
    export fn next(self: &rw Self) -> std::Option<T> {
        return self.vec_iter.next();
    }
}

impl<T> std::Iterator<T> for BinaryHeapIntoIter<T> {
    fn next(self: &rw Self) -> std::Option<T> life_from(self) {
        return self.vec_iter.next();
    }
}

export struct BinaryHeap<T> {
    private data: Vec<T>,
};

// Type-owned constructors; free factories remain migration entry points.
impl<T> BinaryHeap<T> {
    export fn new() -> Self { return binaryheap_new<T>(); }
    export fn with_capacity(capacity: usize) -> Self {
        return binaryheap_with_capacity<T>(capacity);
    }
}


export fn binaryheap_new<T>() -> BinaryHeap<T> {
    return BinaryHeap<T> {
        data: std::vec_new<T>(),
    };
}

export fn binaryheap_with_capacity<T>(capacity: usize) -> BinaryHeap<T> {
    return BinaryHeap<T> {
        data: std::vec_with_capacity<T>(capacity),
    };
}

export fn binaryheap_from_vec<T: std::Ord>(v: Vec<T>) -> BinaryHeap<T> {
    dec rw heap = BinaryHeap<T> {
        data: v,
    };
    dec len = heap.data.len();
    if len <= (1 as usize) {
        return heap;
    }
    dec rw i = len / (2 as usize);
    while true {
        heap.sift_down(i);
        if i == (0 as usize) {
            break;
        }
        i = i - (1 as usize);
    }
    return heap;
}

impl<T> std::Default for BinaryHeap<T> {
    fn default() -> Self {
        return binaryheap_new<T>();
    }
}

impl<T> BinaryHeap<T> {
    export fn len(self: &Self) -> usize {
        return self.data.len();
    }

    export fn is_empty(self: &Self) -> bool {
        return self.data.is_empty();
    }

    export fn capacity(self: &Self) -> usize {
        return self.data.capacity();
    }

    export fn peek(self: &Self) -> std::Option<&T> life_from(self) {
        return self.data.first();
    }

    export fn clear(self: &rw Self) {
        self.data.clear();
    }

    export fn into_vec(self: &rw Self) -> Vec<T> {
        return self.data.take();
    }

    export fn iter(self: &Self) -> std::slice::SliceIter<T> life_from(self) {
        return self.data.iter();
    }

    export fn into_iter(self: Self) -> BinaryHeapIntoIter<T> {
        return BinaryHeapIntoIter<T> {
            vec_iter: self.data.into_iter(),
        };
    }
}

impl<T: std::Ord> BinaryHeap<T> {
    fn sift_up(self: &rw Self, start_idx: usize) {
        dec rw idx = start_idx;
        while idx > (0 as usize) {
            dec parent = (idx - (1 as usize)) / (2 as usize);
            dec slice = self.data.as_slice();
            if slice[parent].cmp(&slice[idx]) < 0 {
                self.data.swap(parent, idx);
                idx = parent;
            } else {
                break;
            }
        }
    }

    fn sift_down(self: &rw Self, start_idx: usize) {
        dec len = self.data.len();
        dec rw idx = start_idx;
        while true {
            dec left = ((2 as usize) * idx) + (1 as usize);
            dec right = ((2 as usize) * idx) + (2 as usize);
            dec rw largest = idx;

            dec slice = self.data.as_slice();
            if left < len {
                if slice[largest].cmp(&slice[left]) < 0 {
                    largest = left;
                }
            }
            if right < len {
                if slice[largest].cmp(&slice[right]) < 0 {
                    largest = right;
                }
            }

            if largest != idx {
                self.data.swap(idx, largest);
                idx = largest;
            } else {
                break;
            }
        }
    }

    export fn push(self: &rw Self, item: T) {
        self.data.push(item);
        dec last_idx = self.data.len() - (1 as usize);
        self.sift_up(last_idx);
    }

    export fn pop(self: &rw Self) -> std::Option<T> {
        dec len = self.data.len();
        if len == (0 as usize) {
            return std::Option::None;
        }
        dec last_idx = len - (1 as usize);
        self.data.swap(0 as usize, last_idx);
        dec val = self.data.pop();
        if self.data.len() > (0 as usize) {
            self.sift_down(0 as usize);
        }
        return val;
    }

    // Drain heap into an ascending sorted Vec
    export fn into_sorted_vec(self: &rw Self) -> Vec<T> {
        dec len = self.data.len();
        dec rw result = std::vec_with_capacity<T>(len);
        while self.data.len() > (0 as usize) {
            dec opt = self.pop();
            match opt {
                std::Option::Some(val) -> {
                    result.push(val);
                },
                std::Option::None -> { break; },
            }
        }
        // Result is in descending order; reverse to ascending
        result.reverse();
        return result;
    }

    export fn retain(self: &rw Self, pred: fn(&T) -> bool) {
        self.data.retain(pred);
        dec len = self.data.len();
        if len <= (1 as usize) {
            return;
        }
        dec rw i = len / (2 as usize);
        while true {
            self.sift_down(i);
            if i == (0 as usize) {
                break;
            }
            i = i - (1 as usize);
        }
    }
}

impl<T: std::Clone> std::Clone for BinaryHeap<T> {
    export fn clone(self: &Self) -> Self {
        return BinaryHeap<T> {
            data: self.data.clone(),
        };
    }
}

}

impl<T> std::IntoIterator<T, std::BinaryHeapIntoIter<T>> for std::BinaryHeap<T> {
    fn into_iter(self: Self) -> std::BinaryHeapIntoIter<T> {
        return self.into_iter();
    }


}
