import <btreemap>;
import <vec>;
import <cmp>;
import <clone>;
import <default>;
import <__lang_drop>;
import <__lang_option>;
import <__lang_iterator>;
import <__lang_into_iterator>;

module std {

export struct BTreeSetIter<T> {
    private keys: BTreeKeys<T, bool>,
};

impl<T> BTreeSetIter<T> {
    export fn next(self: &rw Self) -> std::Option<&T> life_from(self) {
        return self.keys.next();
    }
}

impl<T> std::Iterator<&T> for BTreeSetIter<T> {
    fn next(self: &rw Self) -> std::Option<&T> life_from(self) {
        return self.keys.next();
    }
}

export struct BTreeSetIntoIter<T> {
    private map_iter: BTreeMapIntoIter<T, bool>,
};

impl<T> BTreeSetIntoIter<T> {
    export fn next(self: &rw Self) -> std::Option<T> {
        dec opt = self.map_iter.next();
        match opt {
            std::Option::Some(pair) -> { return std::Option::Some(pair.0); },
            std::Option::None -> { return std::Option::None; },
        }
    }
}

impl<T> std::Iterator<T> for BTreeSetIntoIter<T> {
    fn next(self: &rw Self) -> std::Option<T> life_from(self) {
        return self.next();
    }
}

export struct BTreeSet<T> {
    private map: BTreeMap<T, bool>,
};

// Type-owned constructors; free factories remain migration entry points.
impl<T> BTreeSet<T> {
    export fn new() -> Self { return btreeset_new<T>(); }
}


export fn btreeset_new<T>() -> BTreeSet<T> {
    return BTreeSet<T> {
        map: std::btreemap_new<T, bool>(),
    };
}

impl<T> std::Default for BTreeSet<T> {
    fn default() -> Self {
        return btreeset_new<T>();
    }
}

impl<T> BTreeSet<T> {
    export fn len(self: &Self) -> usize {
        return self.map.len();
    }

    export fn is_empty(self: &Self) -> bool {
        return self.map.is_empty();
    }

    export fn clear(self: &rw Self) {
        self.map.clear();
    }

    export fn first(self: &Self) -> std::Option<&T> life_from(self) {
        return self.map.first_key();
    }

    export fn last(self: &Self) -> std::Option<&T> life_from(self) {
        return self.map.last_key();
    }

    export fn iter(self: &Self) -> BTreeSetIter<T> life_from(self) {
        return BTreeSetIter<T> {
            keys: self.map.keys(),
        };
    }

    export fn into_iter(self: Self) -> BTreeSetIntoIter<T> {
        return BTreeSetIntoIter<T> {
            map_iter: self.map.into_iter(),
        };
    }
}

impl<T: std::Ord> BTreeSet<T> {
    export fn insert(self: &rw Self, value: T) -> bool {
        dec res = self.map.insert(value, true);
        match res {
            std::Option::Some(_) -> { return false; },
            std::Option::None -> { return true; },
        }
    }

    export fn contains(self: &Self, value: &T) -> bool {
        return self.map.contains_key(value);
    }

    export fn is_subset(self: &Self, other: &Self) -> bool {
        if self.len() > other.len() { return false; }
        dec rw it = self.iter();
        while true {
            match it.next() {
                std::Option::Some(value) -> { if other.contains(value) == false { return false; } },
                std::Option::None -> { return true; },
            }
        }
        return true;
    }

    export fn is_superset(self: &Self, other: &Self) -> bool { return other.is_subset(self); }

    export fn is_disjoint(self: &Self, other: &Self) -> bool {
        dec rw it = self.iter();
        while true {
            match it.next() {
                std::Option::Some(value) -> { if other.contains(value) { return false; } },
                std::Option::None -> { return true; },
            }
        }
        return true;
    }

    export fn range(self: &Self, min_val: &T, max_val: &T) -> std::Vec<&T> life_from(self) {
        return self.map.range_keys(min_val, max_val);
    }
}

impl<T: std::Ord + std::Clone> BTreeSet<T> {
    export fn union_owned(self: &Self, other: &Self) -> Self {
        dec rw out = BTreeSet<T>::new();
        dec rw it = self.iter();
        while true {
            match it.next() {
                std::Option::Some(value) -> { if true { out.insert((*value).clone()); } },
                std::Option::None -> { break; },
            }
        }
        dec rw other_it = other.iter();
        while true {
            match other_it.next() {
                std::Option::Some(value) -> { if true { out.insert((*value).clone()); } },
                std::Option::None -> { break; },
            }
        }
        return out;
    }

    export fn intersection_owned(self: &Self, other: &Self) -> Self {
        dec rw out = BTreeSet<T>::new();
        dec rw it = self.iter();
        while true {
            match it.next() {
                std::Option::Some(value) -> { if other.contains(value) { out.insert((*value).clone()); } },
                std::Option::None -> { break; },
            }
        }
        return out;
    }

    export fn difference_owned(self: &Self, other: &Self) -> Self {
        dec rw out = BTreeSet<T>::new();
        dec rw it = self.iter();
        while true {
            match it.next() {
                std::Option::Some(value) -> { if other.contains(value) == false { out.insert((*value).clone()); } },
                std::Option::None -> { break; },
            }
        }
        return out;
    }

    export fn symmetric_difference_owned(self: &Self, other: &Self) -> Self {
        dec rw out = BTreeSet<T>::new();
        dec rw it = self.iter();
        while true {
            match it.next() {
                std::Option::Some(value) -> { if other.contains(value) == false { out.insert((*value).clone()); } },
                std::Option::None -> { break; },
            }
        }
        dec rw other_it = other.iter();
        while true {
            match other_it.next() {
                std::Option::Some(value) -> { if self.contains(value) == false { out.insert((*value).clone()); } },
                std::Option::None -> { break; },
            }
        }
        return out;
    }

}

impl<T: std::Clone> std::Clone for BTreeSet<T> {
    export fn clone(self: &Self) -> Self {
        return BTreeSet<T> {
            map: self.map.clone(),
        };
    }
}

}

impl<T> std::IntoIterator<T, std::BTreeSetIntoIter<T>> for std::BTreeSet<T> {
    fn into_iter(self: Self) -> std::BTreeSetIntoIter<T> {
        return self.into_iter();
    }


}
