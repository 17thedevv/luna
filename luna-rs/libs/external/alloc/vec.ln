import <__alloc_global>;
import <alloc_error>;
import <result>;
import <slice>;
import <ptr>;
import <mem>;
import <clone>;
import <cmp>;
import <default>;
import <__lang_drop>;
import <__lang_option>;
import <__lang_iterator>;
import <__lang_into_iterator>;

module std {

export struct Vec<T> {
    private ptr: *rw T,
    private len: usize,
    private cap: usize,
} requires anchor(ptr) = self;

export fn vec_new<T>() -> Vec<T> {
    return Vec<T> {
        ptr: 0 as usize as *rw T,
        len: 0 as usize,
        cap: 0 as usize,
    };
}

impl<T> std::Default for Vec<T> {
    fn default() -> Self {
        return vec_new<T>();
    }
}

export fn vec_with_capacity<T>(capacity: usize) -> Vec<T> {
    if capacity == (0 as usize) {
        return vec_new<T>();
    }
    dec elem_size = std::mem::size_of<T>() as usize;
    if elem_size > (0 as usize) {
        if capacity > ((18446744073709551615u64 as usize) / elem_size) {
            __luna_panic_default();
        }
    }
    dec size = capacity * elem_size;
    dec align = std::mem::align_of<T>() as usize;
    dec ptr = __luna_alloc(size, align) as usize as *rw T;
    unsafe {
        return Vec<T> {
            ptr: ptr,
            len: 0 as usize,
            cap: capacity,
        };
    }
}

export fn vec_from_slice<T: std::Clone>(slice: &[T]) -> Vec<T> {
    dec rw v = vec_with_capacity<T>(slice.len() as usize);
    v.extend_from_slice(slice);
    return v;
}

export fn vec_repeat<T: std::Clone>(elem: T, count: usize) -> Vec<T> {
    dec rw v = vec_with_capacity<T>(count as usize);
    dec n = count as usize;
    dec rw i = 0 as usize;
    while i < n {
        v.push(elem.clone());
        i = i + (1 as usize);
    }
    return v;
}

export macro vec {
    () => {
        std::vec_new()
    }
    (@elem: expr; @count: expr) => {
        std::vec_repeat(@elem, @count)
    }
    ($(@x: expr),*) => {
        std::vec_from_slice(&[$($x),*])
    }
}

export type VecIter<T> = std::slice::SliceIter<T>;
export type VecIterMut<T> = std::slice::SliceIterMut<T>;

// =========================================================================
// VecIntoIter: Owned, consuming iterator over Vec<T>
// =========================================================================
export struct VecIntoIter<T> {
    private ptr: *rw T,
    private len: usize,
    private cap: usize,
    private index: usize,
};

impl<T> std::Iterator<T> for VecIntoIter<T> {
    fn next(self: &rw Self) -> std::Option<T> life_from(self) {
        if self.index >= self.len {
            return std::Option::None;
        }
        unsafe {
            dec item_ptr = std::ptr::add_mut<T>(self.ptr, self.index);
            dec val = std::ptr::read<T>(item_ptr as *T);
            self.index = self.index + (1 as usize);
            return std::Option::Some(val);
        }
    }
}

impl<T> std::Drop for VecIntoIter<T> {
    fn drop(self: &rw Self) {
        while self.index < self.len {
            unsafe {
                dec item_ptr = std::ptr::add_mut<T>(self.ptr, self.index);
                std::ptr::drop_in_place<T>(item_ptr);
            }
            self.index = self.index + (1 as usize);
        }
        if self.cap > (0 as usize) {
            dec size = self.cap * (std::mem::size_of<T>() as usize);
            dec align = std::mem::align_of<T>() as usize;
            unsafe {
                __luna_dealloc(self.ptr as *rw u8, size, align);
            }
            self.ptr = 0 as usize as *rw T;
            self.cap = 0 as usize;
            self.len = 0 as usize;
        }
    }
}

// =========================================================================
// std::IntoIterator implementations for Vec<T>
// =========================================================================

// Owned: consumes Vec
impl<T> std::IntoIterator<T, VecIntoIter<T>> for Vec<T> {
    fn into_iter(self: Self) -> VecIntoIter<T> {
        dec rw result = VecIntoIter<T> {
            ptr: self.ptr,
            len: self.len,
            cap: self.cap,
            index: 0 as usize,
        };
        self.ptr = 0 as usize as *rw T;
        self.len = 0 as usize;
        self.cap = 0 as usize;
        return result;
    }
}

impl<T> Vec<T> {
    export fn new() -> Self {
        return vec_new<T>();
    }

    export fn with_capacity(capacity: usize) -> Self {
        return vec_with_capacity<T>(capacity as usize);
    }

    export fn try_with_capacity(capacity: usize) -> std::Result<Self, std::AllocError> {
        dec elem_size = sizeof(T) as usize;
        dec max_size = (18446744073709551615u64 as usize);
        dec align = alignof(T) as usize;
        if align == (0 as usize) || align > (4096 as usize) {
            return std::Result::Err(std::AllocError::UnsupportedLayout);
        }
        if elem_size > (0 as usize) {
            if capacity > ((max_size - (align - (1 as usize))) / elem_size) {
                return std::Result::Err(std::AllocError::CapacityOverflow);
            }
        }
        if capacity == (0 as usize) {
            return std::Result::Ok(vec_new<T>());
        }
        dec rw raw: *rw u8 = 0 as usize as *rw u8;
        dec rw status: i32 = 0;
        unsafe {
            status = __luna_try_alloc(capacity * elem_size, alignof(T) as usize, &rw raw as *rw *rw u8);
        }
        if status == 1 { return std::Result::Err(std::AllocError::OutOfMemory); }
        if status == 2 { return std::Result::Err(std::AllocError::CapacityOverflow); }
        if status != 0 { return std::Result::Err(std::AllocError::UnsupportedLayout); }
        unsafe {
            return std::Result::Ok(Vec<T> { ptr: raw as *rw T, len: 0 as usize, cap: capacity as usize });
        }
    }

    // Strong failure guarantee: no fields or initialized values change until
    // allocation succeeds. Only initialized bytes are moved; old storage is
    // then freed without dropping its relocated elements.
    export fn try_reserve(self: &rw Self, additional: usize) -> std::Result<void, std::AllocError> {
        dec max_size = (18446744073709551615u64 as usize);
        dec len = self.len as usize;
        if additional > (max_size - len) {
            return std::Result::Err(std::AllocError::CapacityOverflow);
        }
        dec needed = len + additional;
        if needed <= (self.cap as usize) { return std::Result::Ok; }
        dec elem_size = sizeof(T) as usize;
        dec align = alignof(T) as usize;
        if align == (0 as usize) || align > (4096 as usize) {
            return std::Result::Err(std::AllocError::UnsupportedLayout);
        }
        dec rw limit = max_size;
        if elem_size > (0 as usize) { limit = (max_size - (align - (1 as usize))) / elem_size; }
        if needed > limit { return std::Result::Err(std::AllocError::CapacityOverflow); }
        dec rw capacity = needed;
        if (self.cap as usize) <= (limit / (2 as usize)) {
            dec doubled = (self.cap as usize) * (2 as usize);
            if capacity < doubled { capacity = doubled; }
        }
        if capacity < (4 as usize) && limit >= (4 as usize) { capacity = 4 as usize; }
        dec rw raw: *rw u8 = 0 as usize as *rw u8;
        dec rw status: i32 = 0;
        unsafe {
            status = __luna_try_alloc(capacity * elem_size, alignof(T) as usize, &rw raw as *rw *rw u8);
        }
        if status == 1 { return std::Result::Err(std::AllocError::OutOfMemory); }
        if status == 2 { return std::Result::Err(std::AllocError::CapacityOverflow); }
        if status != 0 { return std::Result::Err(std::AllocError::UnsupportedLayout); }
        unsafe {
            dec new_ptr = raw as *rw T;
            if self.cap > (0 as usize) {
                std::ptr::copy<T>(self.ptr as *T, new_ptr, self.len);
                __luna_dealloc(self.ptr as *rw u8, self.cap * (elem_size as usize), alignof(T) as usize);
            }
            self.ptr = new_ptr;
        }
        self.cap = capacity as usize;
        return std::Result::Ok;
    }

    export fn try_push(self: &rw Self, item: T) -> std::Result<void, std::AllocFailure<T>> {
        match self.try_reserve(1 as usize) {
            std::Result::Err(cause) -> {
                return std::Result::Err(std::AllocFailure<T> { cause: cause, value: item });
            },
            std::Result::Ok -> {},
        }
        unsafe {
            std::ptr::write<T>(std::ptr::add_mut<T>(self.ptr, self.len), item);
        }
        self.len = self.len + (1 as usize);
        return std::Result::Ok;
    }

    export fn push(self: &rw Self, item: T) {
        if self.len == self.cap {
            self.grow();
        }
        unsafe {
            dec target_ptr = std::ptr::add_mut<T>(self.ptr, self.len);
            std::ptr::write<T>(target_ptr, item);
        }
        self.len = self.len + (1 as usize);
    }

    export fn pop(self: &rw Self) -> std::Option<T> {
        if self.len == (0 as usize) {
            return std::Option::None;
        }
        self.len = self.len - (1 as usize);
        unsafe {
            dec target_ptr = std::ptr::add<T>(self.ptr as *T, self.len);
            return std::Option::Some(std::ptr::read<T>(target_ptr));
        }
    }

    export fn clear(self: &rw Self) {
        dec rw i = self.len;
        while i > (0 as usize) {
            i = i - (1 as usize);
            unsafe {
                std::ptr::drop_in_place<T>(std::ptr::add_mut<T>(self.ptr, i));
            }
        }
        self.len = 0 as usize;
    }

    export fn len(self: &Self) -> usize {
        return self.len;
    }

    export fn capacity(self: &Self) -> usize {
        return self.cap;
    }

    export fn is_empty(self: &Self) -> bool {
        return self.len == (0 as usize);
    }

    export fn last(self: &Self) -> std::Option<&T> life_from(self) {
        if self.len == (0 as usize) {
            return std::Option::None;
        }
        unsafe {
            dec offset_ptr = std::ptr::add<T>(self.ptr as *T, self.len - (1 as usize));
            return std::Option::Some(&*offset_ptr);
        }
    }

    export fn last_mut(self: &rw Self) -> std::Option<&rw T> life_from(self) {
        if self.len == (0 as usize) {
            return std::Option::None;
        }
        unsafe {
            dec offset_ptr = std::ptr::add_mut<T>(self.ptr, self.len - (1 as usize));
            return std::Option::Some(&rw *offset_ptr);
        }
    }

    export fn truncate(self: &rw Self, new_len: usize) {
        if new_len >= self.len {
            return;
        }
        dec rw i = self.len;
        while i > new_len {
            i = i - (1 as usize);
            unsafe {
                std::ptr::drop_in_place<T>(std::ptr::add_mut<T>(self.ptr, i));
            }
        }
        self.len = new_len;
    }

    export fn get(self: &Self, index: usize) -> std::Option<&T> life_from(self) {
        if index >= self.len {
            return std::Option::None;
        }
        unsafe {
            dec offset_ptr = std::ptr::add<T>(self.ptr as *T, index);
            return std::Option::Some(&*offset_ptr);
        }
    }

    export fn get_mut(self: &rw Self, index: usize) -> std::Option<&rw T> life_from(self) {
        if index >= self.len {
            return std::Option::None;
        }
        unsafe {
            dec offset_ptr = std::ptr::add_mut<T>(self.ptr, index);
            return std::Option::Some(&rw *offset_ptr);
        }
    }

    export fn as_slice(self: &Self) -> &[T] life_from(self) {
        unsafe {
            return std::mem::slice_from_raw_parts<T>(self.ptr as *T, self.len);
        }
    }

    export fn as_mut_slice(self: &rw Self) -> &rw [T] life_from(self) {
        unsafe {
            return std::mem::slice_from_raw_parts_mut<T>(self.ptr, self.len);
        }
    }

    export fn grow(self: &rw Self) {
        dec elem_size = std::mem::size_of<T>() as usize;
        dec rw new_cap: usize = 0 as usize;
        if self.cap == (0 as usize) {
            new_cap = 4 as usize;
        } else {
            if self.cap > ((18446744073709551615u64 as usize) / (2 as usize)) {
                __luna_panic_default();
            }
            new_cap = self.cap * (2 as usize);
        }
        if elem_size > (0 as usize) {
            if new_cap > ((18446744073709551615u64 as usize) / elem_size) {
                __luna_panic_default();
            }
        }
        
        dec new_size = new_cap * elem_size;
        dec align = std::mem::align_of<T>() as usize;
        dec new_ptr = __luna_alloc(new_size, align) as usize as *rw T;

        if self.cap > (0 as usize) {
            unsafe {
                std::ptr::copy<T>(self.ptr as *T, new_ptr, self.len);
            }
            dec old_size = self.cap * elem_size;
            __luna_dealloc(self.ptr as *rw u8, old_size, align);
        }

        unsafe {
            self.ptr = new_ptr;
        }
        self.cap = new_cap;
    }

    export fn reserve(self: &rw Self, additional: usize) {
        if additional > ((18446744073709551615u64 as usize) - self.len) {
            __luna_panic_default();
        }
        if self.len + additional <= self.cap {
            return;
        }
        dec rw new_cap = self.len + additional;
        if self.cap <= ((18446744073709551615u64 as usize) / (2 as usize)) {
            if new_cap < self.cap * (2 as usize) {
                new_cap = self.cap * (2 as usize);
            }
        }
        if new_cap < (4 as usize) {
            new_cap = 4 as usize;
        }
        dec elem_size = std::mem::size_of<T>() as usize;
        if elem_size > (0 as usize) {
            if new_cap > ((18446744073709551615u64 as usize) / elem_size) {
                if (self.len + additional) > ((18446744073709551615u64 as usize) / elem_size) {
                    __luna_panic_default();
                }
                new_cap = self.len + additional;
            }
        }

        dec new_size = new_cap * elem_size;
        dec align = std::mem::align_of<T>() as usize;
        dec new_ptr = __luna_alloc(new_size, align) as usize as *rw T;

        if self.cap > (0 as usize) {
            unsafe {
                std::ptr::copy<T>(self.ptr as *T, new_ptr, self.len);
            }
            dec old_size = self.cap * elem_size;
            __luna_dealloc(self.ptr as *rw u8, old_size, align);
        }

        unsafe {
            self.ptr = new_ptr;
        }
        self.cap = new_cap;
    }

    export fn iter(self: &Self) -> std::slice::SliceIter<T> life_from(self) {
        return std::slice::slice_iter<T>(self.as_slice());
    }

    export fn iter_mut(self: &rw Self) -> std::slice::SliceIterMut<T> life_from(self) {
        return std::slice::slice_iter_mut<T>(self.as_mut_slice());
    }

    // =========================================================================
    // Phase 4B: Vec Depth Methods
    // =========================================================================

    // O(1) removal: swap element at index with last, pop, return removed value.
    // Does NOT preserve ordering.
    export fn swap_remove(self: &rw Self, index: usize) -> T {
        if index >= self.len {
            __luna_panic_default();
        }
        dec last_idx = self.len - (1 as usize);
        if index != last_idx {
            unsafe {
                dec p_idx = std::ptr::add_mut<T>(self.ptr, index);
                dec p_last = std::ptr::add_mut<T>(self.ptr, last_idx);
                dec tmp = std::ptr::read<T>(p_idx as *T);
                std::ptr::copy<T>(p_last as *T, p_idx, 1 as usize);
                std::ptr::write<T>(p_last, tmp);
            }
        }
        // Pop the last element (which is now the removed element)
        self.len = self.len - (1 as usize);
        unsafe {
            dec target = std::ptr::add<T>(self.ptr as *T, self.len);
            return std::ptr::read<T>(target);
        }
    }

    // In-place filter: retain only elements where pred returns true.
    // Elements for which pred returns false are dropped exactly once.
    export fn retain(self: &rw Self, pred: fn(&T) -> bool) {
        dec rw read: usize = 0 as usize;
        dec rw write: usize = 0 as usize;
        while read < self.len {
            unsafe {
                dec p_read = std::ptr::add<T>(self.ptr as *T, read);
                dec p_fn = pred;
                if p_fn(&*p_read) {
                    // Keep element: move it to write position if needed
                    if read != write {
                        dec p_write = std::ptr::add_mut<T>(self.ptr, write);
                        dec val = std::ptr::read<T>(p_read);
                        std::ptr::write<T>(p_write, val);
                    }
                    write = write + (1 as usize);
                } else {
                    // std::Drop the element
                    dec p_read_mut = std::ptr::add_mut<T>(self.ptr, read);
                    std::ptr::drop_in_place<T>(p_read_mut);
                }
            }
            read = read + (1 as usize);
        }
        self.len = write;
    }

    // Remove consecutive duplicate elements using comparator function.
    // Duplicates are dropped exactly once.
    export fn dedup_by(self: &rw Self, same_bucket: fn(&T, &T) -> bool) {
        if self.len <= (1 as usize) { return; }
        dec rw write: usize = 1 as usize;
        dec rw read: usize = 1 as usize;
        while read < self.len {
            unsafe {
                dec p_read = std::ptr::add<T>(self.ptr as *T, read);
                dec p_prev = std::ptr::add<T>(self.ptr as *T, write - (1 as usize));
                dec eq_fn = same_bucket;
                if eq_fn(&*p_prev, &*p_read) {
                    dec p_read_mut = std::ptr::add_mut<T>(self.ptr, read);
                    std::ptr::drop_in_place<T>(p_read_mut);
                } else {
                    if read != write {
                        dec p_write = std::ptr::add_mut<T>(self.ptr, write);
                        dec val = std::ptr::read<T>(p_read);
                        std::ptr::write<T>(p_write, val);
                    }
                    write = write + (1 as usize);
                }
            }
            read = read + (1 as usize);
        }
        self.len = write;
    }

    // Resize Vec: if new_len < len, truncate and drop extras;
    // if new_len > len, generate new elements using supplier function.
    export fn resize_with(self: &rw Self, new_len: usize, f: fn() -> T) {
        if new_len < self.len {
            self.truncate(new_len);
        } else {
            dec rw count = new_len - self.len;
            while count > (0 as usize) {
                dec f_fn = f;
                self.push(f_fn());
                count = count - (1 as usize);
            }
        }
    }

    // Extend Vec from an std::Iterator
    export fn extend_from_iter<I: std::Iterator<T>>(self: &rw Self, iter: I) {
        dec rw it = iter;
        dec rw running = true;
        while running {
            dec opt = it.next();
            match opt {
                std::Option::Some(val) -> {
                    self.push(val);
                },
                std::Option::None -> {
                    running = false;
                },
            }
        }
    }

    // Insert element at position, shifting all elements after it to the right.
    // Panics if index > len.
    export fn insert(self: &rw Self, index: usize, item: T) {
        if index > self.len {
            __luna_panic_default();
        }
        if self.len == self.cap {
            self.grow();
        }
        // Shift elements from [index..len) one position right
        if index < self.len {
            unsafe {
                dec src = std::ptr::add<T>(self.ptr as *T, index);
                dec dst = std::ptr::add_mut<T>(self.ptr, index + (1 as usize));
                // std::Copy count elements (len - index) from src to dst
                // Must copy from end to avoid overwrite
                dec count = self.len - index;
                dec rw k = count;
                while k > (0 as usize) {
                    k = k - (1 as usize);
                    dec p_src = std::ptr::add<T>(self.ptr as *T, index + k);
                    dec p_dst = std::ptr::add_mut<T>(self.ptr, index + k + (1 as usize));
                    dec val = std::ptr::read<T>(p_src);
                    std::ptr::write<T>(p_dst, val);
                }
            }
        }
        unsafe {
            dec target = std::ptr::add_mut<T>(self.ptr, index);
            std::ptr::write<T>(target, item);
        }
        self.len = self.len + (1 as usize);
    }

    // Remove element at position, shifting all elements after it to the left.
    // Returns the removed element. Panics if index >= len.
    export fn remove(self: &rw Self, index: usize) -> T {
        if index >= self.len {
            __luna_panic_default();
        }
        unsafe {
            dec p_idx = std::ptr::add<T>(self.ptr as *T, index);
            dec removed = std::ptr::read<T>(p_idx);
            // Shift elements from [index+1..len) one position left
            dec rw k: usize = index;
            dec last_idx = self.len - (1 as usize);
            while k < last_idx {
                dec p_src = std::ptr::add<T>(self.ptr as *T, k + (1 as usize));
                dec p_dst = std::ptr::add_mut<T>(self.ptr, k);
                dec val = std::ptr::read<T>(p_src);
                std::ptr::write<T>(p_dst, val);
                k = k + (1 as usize);
            }
            self.len = self.len - (1 as usize);
            return removed;
        }
    }

    // =========================================================================
    // Phase C1: Convenience Methods
    // =========================================================================

    // Transfer buffer ownership, leaving self as a valid empty Vec.
    export fn take(self: &rw Self) -> Vec<T> {
        dec p = self.ptr;
        dec l = self.len;
        dec c = self.cap;
        unsafe {
            self.ptr = 0 as usize as *rw T;
        }
        self.len = 0 as usize;
        self.cap = 0 as usize;
        unsafe {
            return Vec<T> { ptr: p, len: l, cap: c };
        }
    }

    // Swap two elements by index using raw pointers.
    export fn swap(self: &rw Self, i: usize, j: usize) {
        if i >= self.len || j >= self.len {
            __luna_panic_default();
        }
        if i == j { return; }
        unsafe {
            dec pi = std::ptr::add_mut<T>(self.ptr, i);
            dec pj = std::ptr::add_mut<T>(self.ptr, j);
            dec tmp = std::ptr::read<T>(pi as *T);
            std::ptr::copy<T>(pj as *T, pi, 1 as usize);
            std::ptr::write<T>(pj, tmp);
        }
    }

    // Returns a reference to the first element.
    export fn first(self: &Self) -> std::Option<&T> life_from(self) {
        if self.len == (0 as usize) {
            return std::Option::None;
        }
        unsafe {
            return std::Option::Some(&*(self.ptr as *T));
        }
    }

    // Reverse elements in-place.
    export fn reverse(self: &rw Self) {
        std::slice::slice_reverse<T>(self.as_mut_slice());
    }

    // Split vec at position, returning elements [at..] as a new Vec.
    export fn split_off(self: &rw Self, at: usize) -> Vec<T> {
        if at > self.len {
            __luna_panic_default();
        }
        dec new_len = self.len - at;
        dec rw result = vec_with_capacity<T>(new_len);
        dec rw i: usize = 0 as usize;
        while i < new_len {
            unsafe {
                dec src = std::ptr::add<T>(self.ptr as *T, at + i);
                result.push(std::ptr::read<T>(src));
            }
            i = i + (1 as usize);
        }
        self.len = at;
        return result;
    }

    // Move all elements from another Vec into self.
    export fn append(self: &rw Self, other: &rw Vec<T>) {
        dec other_len = other.len;
        if other_len == (0 as usize) { return; }
        self.reserve(other_len);
        dec rw i: usize = 0 as usize;
        while i < other_len {
            unsafe {
                dec src = std::ptr::add<T>(other.ptr as *T, i);
                self.push(std::ptr::read<T>(src));
            }
            i = i + (1 as usize);
        }
        other.len = 0 as usize;
    }
}

impl<T: std::Eq> Vec<T> {
    // Linear search for an element.
    export fn contains(self: &Self, value: &T) -> bool {
        dec s = self.as_slice();
        dec rw i: usize = 0 as usize;
        while i < self.len {
            if s[i].eq(value) {
                return true;
            }
            i = i + (1 as usize);
        }
        return false;
    }
}

impl<T: std::Ord> Vec<T> {
    // Binary search on sorted Vec.
    export fn binary_search(self: &Self, value: &T) -> std::Option<usize> {
        return std::slice::slice_binary_search<T>(self.as_slice(), value);
    }

    // Sort in-place using Ord trait.
    export fn sort(self: &rw Self) {
        std::slice::slice_sort<T>(self.as_mut_slice());
    }
}

extern fn __luna_panic_default();

// Element requirements constrain the impl binder, not a shadowing method binder.
impl<T: std::Eq> Vec<T> {
    // Remove consecutive duplicate elements via Eq; drop each duplicate once.
    export fn dedup(self: &rw Self) {
        if self.len <= (1 as usize) { return; }
        dec rw write: usize = 1 as usize;
        dec rw read: usize = 1 as usize;
        while read < self.len {
            unsafe {
                dec p_read = std::ptr::add<T>(self.ptr as *T, read);
                dec p_prev = std::ptr::add<T>(self.ptr as *T, write - (1 as usize));
                dec r_ref = &*p_read;
                dec p_ref = &*p_prev;
                if p_ref.eq(r_ref) {
                    dec p_read_mut = std::ptr::add_mut<T>(self.ptr, read);
                    std::ptr::drop_in_place<T>(p_read_mut);
                } else {
                    if read != write {
                        dec p_write = std::ptr::add_mut<T>(self.ptr, write);
                        dec val = std::ptr::read<T>(p_read);
                        std::ptr::write<T>(p_write, val);
                    }
                    write = write + (1 as usize);
                }
            }
            read = read + (1 as usize);
        }
        self.len = write;
    }

    // Deprecated alias delegates to the same generic element contract.
    export fn dedup_i32(self: &rw Self) {
        self.dedup();
    }
}

impl<T: std::Clone> Vec<T> {
    // Resize with clones of the provided element value.
    export fn resize(self: &rw Self, new_len: usize, value: T) {
        if new_len < self.len {
            self.truncate(new_len);
        } else {
            dec rw count = new_len - self.len;
            while count > (0 as usize) {
                self.push(value.clone());
                count = count - (1 as usize);
            }
        }
    }

    // Extend from clones of the slice elements.
    export fn extend_from_slice(self: &rw Self, slice: &[T]) {
        dec slen = slice.len as usize;
        if slen == (0 as usize) {
            return;
        }
        self.reserve(slen);
        dec rw i: usize = 0 as usize;
        while i < slen {
            self.push(slice[i].clone());
            i = i + (1 as usize);
        }
    }
}

impl<T> std::Drop for Vec<T> {
    fn drop(self: &rw Self) {
        dec rw i = self.len;
        while i > (0 as usize) {
            i = i - (1 as usize);
            unsafe {
                std::ptr::drop_in_place<T>(std::ptr::add_mut<T>(self.ptr, i));
            }
        }
        if self.cap > (0 as usize) {
            dec old_size = self.cap * (std::mem::size_of<T>() as usize);
            __luna_dealloc(self.ptr as *rw u8, old_size, std::mem::align_of<T>() as usize);
        }
    }
}

impl<T: std::Clone> std::Clone for Vec<T> {
    export fn clone(self: &Self) -> Self {
        dec rw res: Vec<T> = vec_with_capacity<T>(self.len);
        dec s = self.as_slice();
        dec rw i: usize = 0 as usize;
        while i < self.len {
            res.push(s[i].clone());
            i = i + (1 as usize);
        }
        return res;
    }
}

impl<T: std::Eq> std::Eq for Vec<T> {
    export fn eq(self: &Self, other: &Self) -> bool {
        if self.len != other.len {
            return false;
        }
        dec s1 = self.as_slice();
        dec s2 = other.as_slice();
        dec rw i: usize = 0 as usize;
        while i < self.len {
            if s1[i].eq(&s2[i]) == false {
                return false;
            }
            i = i + (1 as usize);
        }
        return true;
    }
}
}

export macro vec {
    () => {
        std::vec_new()
    }
    (@elem: expr; @count: expr) => {
        std::vec_repeat(@elem, @count)
    }
    ($(@x: expr),*) => {
        std::vec_from_slice(&[$($x),*])
    }
}
