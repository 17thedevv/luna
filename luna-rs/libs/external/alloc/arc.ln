import <__alloc_global>;
import <ptr>;
import <mem>;
import <atomic>;
import <result>;
import <__lang_drop>;
import <__lang_option>;

export module std {
    struct ArcBox<T> {
        strong: std::AtomicU64,
        weak: std::AtomicU64,
        value: T,
    };

    export struct Arc<T> {
        private ptr: *rw ArcBox<T>,
    } requires anchor(ptr) = self;

    export struct ArcWeak<T> {
        private ptr: *rw ArcBox<T>,
    } requires anchor(ptr) = self;

    export fn arc_new<T>(val: T) -> Arc<T> {
        dec size = std::mem::size_of<ArcBox<T>>();
        dec align = std::mem::align_of<ArcBox<T>>();
        dec raw = __luna_alloc(size, align) as *rw ArcBox<T>;
        unsafe {
            std::ptr::write<ArcBox<T>>(raw, ArcBox<T> {
                strong: std::atomic_u64_new(1 as u64),
                weak: std::atomic_u64_new(1 as u64),
                value: val,
            });
            return Arc<T> { ptr: raw };
        }
    }

    impl<T> Arc<T> {
        export fn clone(self: &Self) -> Arc<T> {
            unsafe {
                dec box = &*self.ptr;
                box.strong.fetch_add(1 as u64);
                return Arc<T> { ptr: self.ptr };
            }
        }

        export fn downgrade(self: &Self) -> ArcWeak<T> {
            unsafe {
                dec box = &*self.ptr;
                box.weak.fetch_add(1 as u64);
                return ArcWeak<T> { ptr: self.ptr };
            }
        }

        export fn strong_count(self: &Self) -> u64 {
            unsafe {
                return (*self.ptr).strong.load();
            }
        }

        export fn weak_count(self: &Self) -> u64 {
            unsafe {
                dec w = (*self.ptr).weak.load();
                if w > (0 as u64) {
                    return w - (1 as u64);
                }
                return 0 as u64;
            }
        }

        export fn as_ref(self: &Self) -> &T life_from(self) {
            unsafe {
                return &(*self.ptr).value;
            }
        }

        export fn try_unwrap(self: Self) -> std::Result<T, Arc<T>> {
            unsafe {
                dec count = (*self.ptr).strong.load();
                if count == (1 as u64) {
                    dec raw = self.ptr;
                    dec val = std::ptr::read<T>(&(*raw).value as *T);
                    dec w_count = (*raw).weak.load();
                    if w_count <= (1 as u64) {
                        __luna_dealloc(
                            raw as *rw u8,
                            std::mem::size_of<ArcBox<T>>(),
                            std::mem::align_of<ArcBox<T>>()
                        );
                    } else {
                        (*raw).strong.store(0 as u64);
                        (*raw).weak.fetch_sub(1 as u64);
                    }
                    dec rw unwrap_self = self;
                    unwrap_self.ptr = 0 as u64 as *rw ArcBox<T>;
                    return std::Result::Ok(val);
                }
                return std::Result::Err(self);
            }
        }
    }

    impl<T> std::Drop for Arc<T> {
        fn drop(self: &rw Self) {
            if (self.ptr as u64) != (0 as u64) {
                unsafe {
                    dec box = &*self.ptr;
                    dec prev = box.strong.fetch_sub(1 as u64);
                    if prev == (1 as u64) {
                        std::ptr::drop_in_place<T>(&rw (*self.ptr).value);
                        dec prev_w = box.weak.fetch_sub(1 as u64);
                        if prev_w == (1 as u64) {
                            __luna_dealloc(
                                self.ptr as *rw u8,
                                std::mem::size_of<ArcBox<T>>(),
                                std::mem::align_of<ArcBox<T>>()
                            );
                        }
                    }
                    self.ptr = 0 as u64 as *rw ArcBox<T>;
                }
            }
        }
    }

    impl<T> ArcWeak<T> {
        export fn clone(self: &Self) -> ArcWeak<T> {
            unsafe {
                if (self.ptr as u64) == (0 as u64) {
                    return ArcWeak<T> { ptr: self.ptr };
                }
                dec box = &*self.ptr;
                box.weak.fetch_add(1 as u64);
                return ArcWeak<T> { ptr: self.ptr };
            }
        }

        export fn strong_count(self: &Self) -> u64 {
            if (self.ptr as u64) == (0 as u64) {
                return 0 as u64;
            }
            unsafe {
                return (*self.ptr).strong.load();
            }
        }

        export fn weak_count(self: &Self) -> u64 {
            if (self.ptr as u64) == (0 as u64) {
                return 0 as u64;
            }
            unsafe {
                dec w = (*self.ptr).weak.load();
                dec s = (*self.ptr).strong.load();
                if s > (0 as u64) && w > (0 as u64) {
                    return w - (1 as u64);
                }
                return w;
            }
        }

        export fn upgrade(self: &Self) -> std::Option<Arc<T>> {
            if (self.ptr as u64) == (0 as u64) {
                return std::Option::None;
            }
            unsafe {
                dec box = &*self.ptr;
                while true {
                    dec s = box.strong.load();
                    if s == (0 as u64) {
                        return std::Option::None;
                    }
                    dec prev = box.strong.compare_exchange(s, s + (1 as u64));
                    if prev == s {
                        return std::Option::Some(Arc<T> { ptr: self.ptr });
                    }
                }
                return std::Option::None;
            }
        }
    }

    impl<T> std::Drop for ArcWeak<T> {
        fn drop(self: &rw Self) {
            if (self.ptr as u64) != (0 as u64) {
                unsafe {
                    dec box = &*self.ptr;
                    dec prev_w = box.weak.fetch_sub(1 as u64);
                    if prev_w == (1 as u64) {
                        if box.strong.load() == (0 as u64) {
                            __luna_dealloc(
                                self.ptr as *rw u8,
                                std::mem::size_of<ArcBox<T>>(),
                                std::mem::align_of<ArcBox<T>>()
                            );
                        }
                    }
                    self.ptr = 0 as u64 as *rw ArcBox<T>;
                }
            }
        }
    }
}
