import <hashmap>;
import <default>;
import <hash>;
import <cmp>;
import <clone>;
import <__lang_option>;
import <__lang_iterator>;
import <__lang_into_iterator>;
import <__lang_drop>;

module std {
    export struct SetIntoIter<T> {
        private map: std::MapIntoIter<T, ()>,
    };

    impl<T> SetIntoIter<T> {
        export fn next(self: &rw Self) -> std::Option<T> {
            dec opt = self.map.next();
            match opt {
                std::Option::Some(tup) -> {
                    return std::Option::Some(tup.0);
                }
                std::Option::None -> {
                    return std::Option::None;
                }
            }
        }
    }

    impl<T> std::Iterator<T> for SetIntoIter<T> {
        fn next(self: &rw Self) -> std::Option<T> life_from(self) {
            return self.next();
        }
    }


    export struct SetIter<T> {
        private keys: std::Keys<T, ()>,
    };

    impl<T> SetIter<T> {
        export fn next(self: &rw Self) -> std::Option<&T> {
            return self.keys.next();
        }
    }

    impl<T> std::Iterator<&T> for SetIter<T> {
        fn next(self: &rw Self) -> std::Option<&T> life_from(self) {
            return self.keys.next();
        }
    }

    export struct HashSet<T> {
        private map: std::HashMap<T, ()>,
    };

    export fn hashset_new<T>() -> HashSet<T> {
        return HashSet {
            map: std::hashmap_new<T, ()>(),
        };
    }

    impl<T> std::Default for HashSet<T> {
        fn default() -> Self {
            return hashset_new<T>();
        }
    }

    export fn hashset_with_capacity<T>(capacity: u64) -> HashSet<T> {
        return HashSet {
            map: std::hashmap_with_capacity<T, ()>(capacity),
        };
    }

    impl<T: std::Hash + std::Eq> HashSet<T> {
        export fn len(self: &Self) -> u64 {
            return self.map.len();
        }

        export fn capacity(self: &Self) -> u64 {
            return self.map.capacity();
        }

        export fn is_empty(self: &Self) -> bool {
            return self.map.is_empty();
        }

        export fn insert(self: &rw Self, value: T) -> bool {
            return self.map.insert(value, ());
        }

        export fn contains(self: &Self, value: &T) -> bool {
            return self.map.contains_key(value);
        }

        export fn remove(self: &rw Self, value: &T) -> bool {
            return self.map.remove(value);
        }

        export fn clear(self: &rw Self) {
            self.map.clear();
        }

        export fn iter(self: &Self) -> SetIter<T> life_from(self) {
            return SetIter<T> {
                keys: self.map.keys(),
            };
        }

        export fn into_iter(self: Self) -> SetIntoIter<T> {
            return SetIntoIter<T> {
                map: self.map.into_iter(),
            };
        }
    }

    impl<T: std::Clone + std::Hash + std::Eq> HashSet<T> {
        export fn union_owned(self: &Self, other: &Self) -> HashSet<T> {
            dec rw res = hashset_new<T>();
            dec rw it_a = self.iter();
            while true {
                dec item = it_a.next();
                match item {
                    std::Option::Some(val) -> {
                        res.insert((*val).clone());
                    },
                    std::Option::None -> { break; },
                }
            }
            dec rw it_b = other.iter();
            while true {
                dec item = it_b.next();
                match item {
                    std::Option::Some(val) -> {
                        res.insert((*val).clone());
                    },
                    std::Option::None -> { break; },
                }
            }
            return res;
        }

        export fn intersection_owned(self: &Self, other: &Self) -> HashSet<T> {
            dec rw res = hashset_new<T>();
            dec rw it_a = self.iter();
            while true {
                dec item = it_a.next();
                match item {
                    std::Option::Some(val) -> {
                        if other.contains(val) {
                            res.insert((*val).clone());
                        }
                    },
                    std::Option::None -> { break; },
                }
            }
            return res;
        }

        export fn difference_owned(self: &Self, other: &Self) -> HashSet<T> {
            dec rw res = hashset_new<T>();
            dec rw it_a = self.iter();
            while true {
                dec item = it_a.next();
                match item {
                    std::Option::Some(val) -> {
                        if other.contains(val) == false {
                            res.insert((*val).clone());
                        }
                    },
                    std::Option::None -> { break; },
                }
            }
            return res;
        }
    }

    export fn union_owned<T: std::Clone + std::Hash + std::Eq>(a: &HashSet<T>, b: &HashSet<T>) -> HashSet<T> {
        return a.union_owned(b);
    }

    export fn intersection_owned<T: std::Clone + std::Hash + std::Eq>(a: &HashSet<T>, b: &HashSet<T>) -> HashSet<T> {
        return a.intersection_owned(b);
    }

    export fn difference_owned<T: std::Clone + std::Hash + std::Eq>(a: &HashSet<T>, b: &HashSet<T>) -> HashSet<T> {
        return a.difference_owned(b);
    }
}

impl<T> std::IntoIterator<T, std::SetIntoIter<T>> for std::HashSet<T> {
    fn into_iter(self: Self) -> std::SetIntoIter<T> {
        return self.into_iter();
    }
}


