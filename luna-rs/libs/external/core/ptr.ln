export module std {
    export module ptr {
        export unsafe fn read<T>(src: *T) -> T {
            return *src;
        }
    
        export unsafe fn write<T>(dst: *rw T, val: T) {
            *dst = val;
        }
    
        #[lang("drop_in_place")]
        export unsafe intrinsic fn drop_in_place<T>(p: *rw T);
    
        export unsafe fn add<T>(p: *T, count: usize) -> *T {
            return (p as usize + (count * (sizeof(T) as usize))) as *T;
        }
    
        export unsafe fn add_mut<T>(p: *rw T, count: usize) -> *rw T {
            return (p as usize + (count * (sizeof(T) as usize))) as *rw T;
        }
    
        export unsafe fn offset<T>(p: *T, count: i64) -> *T {
            return (p as usize + (count as usize * (sizeof(T) as usize))) as *T;
        }
    
        export unsafe fn offset_mut<T>(p: *rw T, count: i64) -> *rw T {
            return (p as usize + (count as usize * (sizeof(T) as usize))) as *rw T;
        }
    
        export unsafe fn diff<T>(a: *T, b: *T) -> i64 {
            return ((a as i64) - (b as i64)) / (sizeof(T) as i64);
        }
    
        export unsafe fn copy<T>(src: *T, dst: *rw T, count: usize) {
            dec bytes = count * (sizeof(T) as usize);
            dec s_u8 = src as usize as *u8;
            dec d_u8 = dst as usize as *rw u8;
            dec rw i: usize = 0 as usize;
            while i < bytes {
                dec s = (s_u8 as usize + i) as *u8;
                dec d = (d_u8 as usize + i) as *rw u8;
                *d = *s;
                i = i + (1 as usize);
            }
        }

        /// Swaps values between two memory locations.
        /// Preconditions:
        /// - If a == b: safe no-op.
        /// - If a != b: both pointers must be valid for T, properly aligned, and non-overlapping.
        /// Pure bitwise move semantics: reads and writes without dropping either location.
        export unsafe fn swap<T>(a: *rw T, b: *rw T) {
            if (a as usize) == (b as usize) {
                return;
            }
            dec bytes = sizeof(T) as usize;
            dec a_u8 = a as usize as *rw u8;
            dec b_u8 = b as usize as *rw u8;
            dec rw i: usize = 0 as usize;
            while i < bytes {
                dec ap = (a_u8 as usize + i) as *rw u8;
                dec bp = (b_u8 as usize + i) as *rw u8;
                dec tmp = *ap;
                *ap = *bp;
                *bp = tmp;
                i = i + (1 as usize);
            }
        }

        export struct NonNull<T> {
            private pointer: *rw T,
        } requires anchor(pointer) = self;

        export unsafe fn nonnull_new_unchecked<T>(p: *rw T) -> NonNull<T> {
            unsafe {
                return NonNull<T> { pointer: p };
            }
        }

        impl<T> NonNull<T> {
            export fn is_null(self: &Self) -> bool {
                return (self.pointer as usize) == (0 as usize);
            }

            export fn as_ptr(self: &Self) -> *rw T {
                return self.pointer;
            }

            export fn as_ref(self: &Self) -> &T life_from(self) {
                unsafe {
                    return &*(self.pointer as *T);
                }
            }

            export fn as_mut(self: &rw Self) -> &rw T life_from(self) {
                unsafe {
                    return &rw *self.pointer;
                }
            }
        }
    }
}
