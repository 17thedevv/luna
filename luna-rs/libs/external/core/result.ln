import <core/panic>;
import <__lang_option>;

export module std {
export enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T, E> Result<T, E> {
    export fn is_ok(self: &Self) -> bool {
        match *self {
            Result::Ok(_) -> true,
            Result::Err(_) -> false,
        }
    }

    export fn is_err(self: &Self) -> bool {
        match *self {
            Result::Ok(_) -> false,
            Result::Err(_) -> true,
        }
    }

    export fn as_ref(self: &Self) -> Result<&T, &E> life_from(self) {
        if self.is_ok() {
            unsafe {
                return Result::Ok(&*(((self as *Self as u64) + (8 as u64)) as *T));
            }
        }
        unsafe {
            return Result::Err(&*(((self as *Self as u64) + (8 as u64)) as *E));
        }
    }

    export fn as_mut(self: &rw Self) -> Result<&rw T, &rw E> life_from(self) {
        if self.is_ok() {
            unsafe {
                return Result::Ok(&rw *(((self as *rw Self as u64) + (8 as u64)) as *rw T));
            }
        }
        unsafe {
            return Result::Err(&rw *(((self as *rw Self as u64) + (8 as u64)) as *rw E));
        }
    }

    export fn ok(self: Self) -> std::Option<T> {
        return match self {
            Result::Ok(val) -> std::Option::Some(val),
            Result::Err(e) -> std::Option::None,
        };
    }

    export fn err(self: Self) -> std::Option<E> {
        return match self {
            Result::Ok(val) -> std::Option::None,
            Result::Err(e) -> std::Option::Some(e),
        };
    }

    export fn unwrap(self: Self) -> T {
        match self {
            Result::Ok(val) -> val,
            Result::Err(_) -> __luna_panic(),
        }
    }

    export fn map<U>(self: Self, f: fn(T) -> U) -> Result<U, E> {
        return match self {
            Result::Ok(val) -> Result::Ok(f(val)),
            Result::Err(e) -> Result::Err(e),
        };
    }

    export fn and_then<U>(self: Self, f: fn(T) -> Result<U, E>) -> Result<U, E> {
        return match self {
            Result::Ok(val) -> f(val),
            Result::Err(e) -> Result::Err(e),
        };
    }

    export fn unwrap_or_else(self: Self, f: fn(E) -> T) -> T {
        return match self {
            Result::Ok(val) -> val,
            Result::Err(e) -> f(e),
        };
    }

    export fn map_err<F>(self: Self, f: fn(E) -> F) -> Result<T, F> {
        return match self {
            Result::Ok(val) -> Result::Ok(val),
            Result::Err(e) -> Result::Err(f(e)),
        };
    }

    export fn or_else<F>(self: Self, f: fn(E) -> Result<T, F>) -> Result<T, F> {
        return match self {
            Result::Ok(val) -> Result::Ok(val),
            Result::Err(e) -> f(e),
        };
    }
}

export trait OptionExt<T> {
    fn ok_or<E>(self: Self, err: E) -> Result<T, E>;
}

impl<T> OptionExt<T> for std::Option<T> {
    fn ok_or<E>(self: Self, err: E) -> Result<T, E> {
        return match self {
            std::Option::Some(val) -> Result::Ok(val),
            std::Option::None -> Result::Err(err),
        };
    }
}

export fn result_flatten<T, E>(res: Result<Result<T, E>, E>) -> Result<T, E> {
    return match res {
        Result::Ok(inner) -> inner,
        Result::Err(e) -> Result::Err(e),
    };
}

export fn option_transpose<T, E>(opt: std::Option<Result<T, E>>) -> Result<std::Option<T>, E> {
    return match opt {
        std::Option::Some(res) -> {
            match res {
                Result::Ok(val) -> Result::Ok(std::Option::Some(val)),
                Result::Err(e) -> Result::Err(e),
            }
        },
        std::Option::None -> Result::Ok(std::Option::None),
    };
}

export fn result_transpose<T, E>(res: Result<std::Option<T>, E>) -> std::Option<Result<T, E>> {
    return match res {
        Result::Ok(opt) -> {
            match opt {
                std::Option::Some(val) -> std::Option::Some(Result::Ok(val)),
                std::Option::None -> std::Option::None,
            }
        },
        Result::Err(e) -> std::Option::Some(Result::Err(e)),
    };
}

}


