import <core/panic>;
import <__lang_option>;
import <result>;

export module std {
#[lang("from_residual")]
export trait FromResidual<R> {
    #[lang("from_residual_fn")]
    fn from_residual(residual: R) -> Self;
}

#[lang("try")]
export trait Try {
    type Output;
    type Residual;
    
    #[lang("try_from_output")]
    fn from_output(v: Self::Output) -> Self;
    
    #[lang("try_branch")]
    fn branch(self: Self) -> std::ControlFlow<Self::Residual, Self::Output>;
}

#[lang("control_flow")]
export enum ControlFlow<B, C> {
    #[lang("continue")]
    Continue(C),
    #[lang("break")]
    Break(B),
}

export enum Infallible {
    InfallibleVariant,
}

impl<T, E> std::FromResidual<std::Result<std::Infallible, E> > for std::Result<T, E> {
    fn from_residual(residual: std::Result<std::Infallible, E>) -> Self {
        return match residual {
            std::Result::Err(e) -> std::Result::Err(e),
            std::Result::Ok(_) -> __luna_panic(),
        };
    }
}

impl<T, E> std::Try for std::Result<T, E> {
    type Output = T;
    type Residual = std::Result<std::Infallible, E>;
    
    fn from_output(v: T) -> Self {
        return std::Result::Ok(v);
    }
    
    fn branch(self: Self) -> std::ControlFlow<std::Result<std::Infallible, E>, T> {
        return match self {
            std::Result::Ok(v) -> std::ControlFlow::Continue(v),
            std::Result::Err(e) -> std::ControlFlow::Break(std::Result::Err(e)),
        };
    }
}

impl<T> std::FromResidual<std::Option<std::Infallible> > for std::Option<T> {
    fn from_residual(residual: std::Option<std::Infallible>) -> Self {
        return match residual {
            std::Option::None -> std::Option::None,
            std::Option::Some(_) -> __luna_panic(),
        };
    }
}

impl<T> std::Try for std::Option<T> {
    type Output = T;
    type Residual = std::Option<std::Infallible>;

    fn from_output(v: T) -> Self {
        return std::Option::Some(v);
    }

    fn branch(self: Self) -> std::ControlFlow<std::Option<std::Infallible>, T> {
        return match self {
            std::Option::Some(v) -> std::ControlFlow::Continue(v),
            std::Option::None -> std::ControlFlow::Break(std::Option::None),
        };
    }
}

    // =========================================================================
    // Async / Future Primitives
    // =========================================================================

    export enum Poll<T> {
        Ready(T),
        Pending,
    }

    impl<T> Poll<T> {
        export fn is_ready(self: &Self) -> bool {
            return match *self {
                Poll::Ready(_) -> true,
                Poll::Pending -> false,
            };
        }

        export fn is_pending(self: &Self) -> bool {
            return match *self {
                Poll::Ready(_) -> false,
                Poll::Pending -> true,
            };
        }
    }

    export struct Waker {
        data: *rw void,
    };

    export struct Context {
        waker: *Waker,
    };

    export fn context_from_waker(w: *Waker) -> Context {
        return Context { waker: w };
    }

    impl Context {
        export fn from_waker(w: *Waker) -> Context {
            return context_from_waker(w);
        }

        export fn waker(self: &Self) -> *Waker {
            return self.waker;
        }
    }

    export trait Future<Output> {
        fn poll(self: &rw Self, cx: &rw Context) -> Poll<Output>;
    }
}
