import <__lang_option>;

export module std {
export trait Default {
    fn default() -> Self;
}

impl Default for bool { fn default() -> Self { return false; } }
impl Default for u8 { fn default() -> Self { return 0 as u8; } }
impl Default for u16 { fn default() -> Self { return 0 as u16; } }
impl Default for u32 { fn default() -> Self { return 0 as u32; } }
impl Default for u64 { fn default() -> Self { return 0 as u64; } }
impl Default for usize { fn default() -> Self { return 0 as usize; } }
impl Default for i8 { fn default() -> Self { return 0 as i8; } }
impl Default for i16 { fn default() -> Self { return 0 as i16; } }
impl Default for i32 { fn default() -> Self { return 0; } }
impl Default for i64 { fn default() -> Self { return 0 as i64; } }
impl Default for isize { fn default() -> Self { return 0 as isize; } }
impl Default for f32 { fn default() -> Self { return 0.0 as f32; } }
impl Default for f64 { fn default() -> Self { return 0.0 as f64; } }

impl<T> Default for std::Option<T> {
    fn default() -> Self { return std::Option::None; }
}
}
