import <__lang_option>;
import <__lang_iterator>;
import <ptr>;
import <mem>;
import <cmp>;
import <clone>;

// Provider-private helper used by the nested public std::slice sorting API.
// Keeping this implementation at provider scope preserves its internal linkage.
fn floor_log2(n: u64) -> u64 {
    dec rw result: u64 = 0 as u64;
    dec rw val = n;
    while val > (1 as u64) {
        val = val / (2 as u64);
        result = result + (1 as u64);
    }
    return result;
}

export module std {
    export module slice {
    // SliceIter: Borrowed iterator over slice
    // ITER-4: A borrowed collection iterator MUST NOT transfer ownership
    // ITER-9: SliceIter<T>::Item is &T
    // ITER-10: SliceIter does not move/drop backing elements
    // =========================================================================
    export struct SliceIter<T> {
        private ptr: *T,
        private end: *T,
    } requires anchor(ptr) = self
      requires anchor(end) = self;
    
    impl<T> SliceIter<T> {
        // Shared borrow iteration - returns reference to backing element
        export fn next_ref(self: &rw Self) -> std::Option<&T> life_from(self) {
            if (self.ptr as u64) >= (self.end as u64) {
                return std::Option::None;
            }
            dec rw step: u64 = sizeof(T) as u64;
            if step == (0 as u64) {
                step = 1 as u64;
            }
            unsafe {
                self.ptr = (self.ptr as u64 + step) as *T;
                dec item_ptr = (self.ptr as u64 - step) as *T;
                return std::Option::Some(&*item_ptr);
            }
        }
    }
    
    // ITER-9: Item is &T (borrowed reference, not owned value)
    impl<T> std::Iterator<&T> for SliceIter<T> {
        fn next(self: &rw Self) -> std::Option<&T> life_from(self) {
            return self.next_ref();
        }
    }

    impl<T> std::Clone for SliceIter<T> {
        fn clone(self: &Self) -> Self {
            unsafe {
                return SliceIter<T> {
                    ptr: self.ptr,
                    end: self.end,
                };
            }
        }
    }
    
    export struct SliceIterMut<T> {
        private ptr: *rw T,
        private end: *rw T,
    } requires anchor(ptr) = self
      requires anchor(end) = self;
    
    impl<T> SliceIterMut<T> {
        export fn next_mut(self: &rw Self) -> std::Option<&rw T> life_from(self) {
            if (self.ptr as u64) >= (self.end as u64) {
                return std::Option::None;
            }
            dec rw step: u64 = sizeof(T) as u64;
            if step == (0 as u64) {
                step = 1 as u64;
            }
            unsafe {
                self.ptr = (self.ptr as u64 + step) as *rw T;
                dec item_ptr = (self.ptr as u64 - step) as *rw T;
                return std::Option::Some(&rw *item_ptr);
            }
        }
    }
    
    impl<T> std::Iterator<&rw T> for SliceIterMut<T> {
        fn next(self: &rw Self) -> std::Option<&rw T> life_from(self) {
            return self.next_mut();
        }
    }
    
    export fn slice_iter<T>(s: &[T]) -> SliceIter<T> life_from(s) {
        dec rw step: u64 = sizeof(T) as u64;
        if step == (0 as u64) {
            step = 1 as u64;
        }
        dec end_ptr = (s.data as u64 + (s.len as u64 * step)) as *T;
        unsafe {
            return SliceIter<T> {
                ptr: s.data as *T,
                end: end_ptr,
            };
        }
    }
    
    export fn slice_iter_mut<T>(s: &rw [T]) -> SliceIterMut<T> life_from(s) {
        dec rw step: u64 = sizeof(T) as u64;
        if step == (0 as u64) {
            step = 1 as u64;
        }
        dec end_ptr = (s.data as u64 + (s.len as u64 * step)) as *rw T;
        unsafe {
            return SliceIterMut<T> {
                ptr: s.data as *rw T,
                end: end_ptr,
            };
        }
    }
// =========================================================================
// Slice utility functions
// =========================================================================

export fn slice_len<T>(s: &[T]) -> u64 {
    return s.len as u64;
}

export fn slice_get<T>(s: &[T], index: u64) -> std::Option<&T> life_from(s) {
    if index >= (s.len as u64) {
        return std::Option::None;
    }
    unsafe {
        dec p = std::ptr::add<T>(s.data as *T, index);
        return std::Option::Some(&*p);
    }
}

export fn slice_get_mut<T>(s: &rw [T], index: u64) -> std::Option<&rw T> life_from(s) {
    if index >= (s.len as u64) {
        return std::Option::None;
    }
    unsafe {
        dec p = std::ptr::add_mut<T>(s.data as *rw T, index);
        return std::Option::Some(&rw *p);
    }
}

export fn split_at<T>(s: &[T], mid: u64) -> (&[T], &[T]) life_from(s) {
    dec slen = s.len as u64;
    if mid > slen {
        __luna_panic_default();
    }
    unsafe {
        dec p1 = s.data as *T;
        dec p2 = std::ptr::add<T>(p1, mid);
        dec left = std::mem::slice_from_raw_parts<T>(p1, mid);
        dec right = std::mem::slice_from_raw_parts<T>(p2, slen - mid);
        return (left, right);
    }
}

export fn split_at_mut<T>(s: &rw [T], mid: u64) -> (&rw [T], &rw [T]) life_from(s) {
    dec slen = s.len as u64;
    if mid > slen {
        __luna_panic_default();
    }
    unsafe {
        dec p1 = s.data as *rw T;
        dec p2 = std::ptr::add_mut<T>(p1, mid);
        dec left = std::mem::slice_from_raw_parts_mut<T>(p1, mid);
        dec right = std::mem::slice_from_raw_parts_mut<T>(p2, slen - mid);
        return (left, right);
    }
}

export fn slice_reverse<T>(s: &rw [T]) {
    dec slen = s.len as u64;
    if slen <= (1 as u64) {
        return;
    }
    dec rw lo: u64 = 0 as u64;
    dec rw hi: u64 = slen - (1 as u64);
    while lo < hi {
        unsafe {
            dec p_lo = std::ptr::add_mut<T>(s.data as *rw T, lo);
            dec p_hi = std::ptr::add_mut<T>(s.data as *rw T, hi);
            dec tmp = std::ptr::read<T>(p_lo as *T);
            std::ptr::copy<T>(p_hi as *T, p_lo, 1 as u64);
            std::ptr::write<T>(p_hi, tmp);
        }
        lo = lo + (1 as u64);
        hi = hi - (1 as u64);
    }
}

export fn slice_contains_i32(s: &[i32], value: i32) -> bool {
    dec rw i: u64 = 0 as u64;
    dec slen = s.len as u64;
    while i < slen {
        unsafe {
            dec p = std::ptr::add<i32>(s.data as *i32, i);
            if *p == value {
                return true;
            }
        }
        i = i + (1 as u64);
    }
    return false;
}

export fn slice_binary_search_i32(s: &[i32], value: i32) -> std::Option<u64> {
    dec slen = s.len as u64;
    if slen == (0 as u64) {
        return std::Option::None;
    }
    dec rw lo: u64 = 0 as u64;
    dec rw hi: u64 = slen;
    while lo < hi {
        dec mid = lo + ((hi - lo) / (2 as u64));
        unsafe {
            dec p = std::ptr::add<i32>(s.data as *i32, mid);
            dec v = *p;
            if v == value {
                return std::Option::Some(mid);
            }
            if v < value {
                lo = mid + (1 as u64);
            } else {
                hi = mid;
            }
        }
    }
    return std::Option::None;
}

// =========================================================================
// Slice Sorting: Introsort — O(n log n) worst-case, O(log n) space
// =========================================================================

// Insertion sort for small subarrays (n <= 16)
fn insertion_sort_by<T>(data: *rw T, lo: u64, hi: u64, compare: fn(&T, &T) -> i32) {
    dec rw i = lo + (1 as u64);
    while i < hi {
        unsafe {
            dec rw j = i;
            dec tmp = std::ptr::read<T>(std::ptr::add<T>(data as *T, j) as *T);
            dec rw cont = true;
            while cont {
                if j <= lo {
                    cont = false;
                } else {
                    dec prev = std::ptr::add<T>(data as *T, j - (1 as u64));
                    dec cmp_fn = compare;
                    dec c = cmp_fn(&*prev, &tmp);
                    if c > 0 {
                        // Shift element right
                        dec dest = std::ptr::add_mut<T>(data, j);
                        std::ptr::copy<T>(prev, dest, 1 as u64);
                        j = j - (1 as u64);
                    } else {
                        cont = false;
                    }
                }
            }
            std::ptr::write<T>(std::ptr::add_mut<T>(data, j), tmp);
        }
        i = i + (1 as u64);
    }
}

// Heapsort fallback when recursion depth exceeded
fn heapsort_by<T>(data: *rw T, lo: u64, hi: u64, compare: fn(&T, &T) -> i32) {
    dec n = hi - lo;
    if n <= (1 as u64) { return; }

    // Build max-heap (sift down from last parent to root)
    dec rw start_idx = n / (2 as u64);
    while start_idx > (0 as u64) {
        start_idx = start_idx - (1 as u64);
        sift_down_by<T>(data, lo, start_idx, n, compare);
    }

    // Extract max elements
    dec rw end_idx = n - (1 as u64);
    while end_idx > (0 as u64) {
        // Swap root (lo) with end
        unsafe {
            dec p_root = std::ptr::add_mut<T>(data, lo);
            dec p_end = std::ptr::add_mut<T>(data, lo + end_idx);
            dec tmp = std::ptr::read<T>(p_root as *T);
            std::ptr::copy<T>(p_end as *T, p_root, 1 as u64);
            std::ptr::write<T>(p_end, tmp);
        }
        sift_down_by<T>(data, lo, 0 as u64, end_idx, compare);
        end_idx = end_idx - (1 as u64);
    }
}

fn sift_down_by<T>(data: *rw T, base: u64, start: u64, heap_size: u64, compare: fn(&T, &T) -> i32) {
    dec rw root = start;
    dec rw running = true;
    while running {
        dec left = (2 as u64) * root + (1 as u64);
        if left >= heap_size {
            running = false;
        } else {
            dec rw largest = root;
            // Compare left child
            unsafe {
                dec p_largest = std::ptr::add<T>(data as *T, base + largest);
                dec p_left = std::ptr::add<T>(data as *T, base + left);
                dec cmp_fn = compare;
                if cmp_fn(&*p_left, &*p_largest) > 0 {
                    largest = left;
                }
            }
            // Compare right child if exists
            dec right = left + (1 as u64);
            if right < heap_size {
                unsafe {
                    dec p_largest2 = std::ptr::add<T>(data as *T, base + largest);
                    dec p_right = std::ptr::add<T>(data as *T, base + right);
                    dec cmp_fn2 = compare;
                    if cmp_fn2(&*p_right, &*p_largest2) > 0 {
                        largest = right;
                    }
                }
            }
            if largest == root {
                running = false;
            } else {
                // Swap root with largest
                unsafe {
                    dec p_r = std::ptr::add_mut<T>(data, base + root);
                    dec p_l = std::ptr::add_mut<T>(data, base + largest);
                    dec tmp = std::ptr::read<T>(p_r as *T);
                    std::ptr::copy<T>(p_l as *T, p_r, 1 as u64);
                    std::ptr::write<T>(p_l, tmp);
                }
                root = largest;
            }
        }
    }
}

// Partition using median-of-three pivot
fn partition_by<T>(data: *rw T, lo: u64, hi: u64, compare: fn(&T, &T) -> i32) -> u64 {
    // hi is exclusive, so last element is at hi - 1
    dec last = hi - (1 as u64);
    dec mid = lo + ((last - lo) / (2 as u64));

    // Sort lo, mid, last (median-of-three)
    unsafe {
        dec p_lo = std::ptr::add_mut<T>(data, lo);
        dec p_mid = std::ptr::add_mut<T>(data, mid);
        dec p_last = std::ptr::add_mut<T>(data, last);

        dec cmp1 = compare;
        if cmp1(&*(p_lo as *T), &*(p_mid as *T)) > 0 {
            dec tmp = std::ptr::read<T>(p_lo as *T);
            std::ptr::copy<T>(p_mid as *T, p_lo, 1 as u64);
            std::ptr::write<T>(p_mid, tmp);
        }
        dec cmp2 = compare;
        if cmp2(&*(p_lo as *T), &*(p_last as *T)) > 0 {
            // Reload pointers after potential swap
            dec p_lo2 = std::ptr::add_mut<T>(data, lo);
            dec p_last2 = std::ptr::add_mut<T>(data, last);
            dec tmp2 = std::ptr::read<T>(p_lo2 as *T);
            std::ptr::copy<T>(p_last2 as *T, p_lo2, 1 as u64);
            std::ptr::write<T>(p_last2, tmp2);
        }
        dec cmp3 = compare;
        dec p_mid3 = std::ptr::add_mut<T>(data, mid);
        dec p_last3 = std::ptr::add_mut<T>(data, last);
        if cmp3(&*(p_mid3 as *T), &*(p_last3 as *T)) > 0 {
            dec tmp3 = std::ptr::read<T>(p_mid3 as *T);
            std::ptr::copy<T>(p_last3 as *T, p_mid3, 1 as u64);
            std::ptr::write<T>(p_last3, tmp3);
        }
    }

    // Pivot is at mid position, swap to lo
    unsafe {
        dec p_lo_swap = std::ptr::add_mut<T>(data, lo);
        dec p_mid_swap = std::ptr::add_mut<T>(data, mid);
        dec tmp_swap = std::ptr::read<T>(p_lo_swap as *T);
        std::ptr::copy<T>(p_mid_swap as *T, p_lo_swap, 1 as u64);
        std::ptr::write<T>(p_mid_swap, tmp_swap);
    }

    // Lomuto partition scheme
    dec rw i = lo + (1 as u64);
    dec rw store = lo + (1 as u64);
    while i < hi {
        unsafe {
            dec p_i = std::ptr::add<T>(data as *T, i);
            dec p_pivot = std::ptr::add<T>(data as *T, lo);
            dec cmp_fn = compare;
            if cmp_fn(&*p_i, &*p_pivot) < 0 {
                if i != store {
                    dec p_store = std::ptr::add_mut<T>(data, store);
                    dec p_i_mut = std::ptr::add_mut<T>(data, i);
                    dec tmp = std::ptr::read<T>(p_store as *T);
                    std::ptr::copy<T>(p_i_mut as *T, p_store, 1 as u64);
                    std::ptr::write<T>(p_i_mut, tmp);
                }
                store = store + (1 as u64);
            }
        }
        i = i + (1 as u64);
    }

    // Move pivot into final position
    dec pivot_final = store - (1 as u64);
    if lo != pivot_final {
        unsafe {
            dec p_lo_final = std::ptr::add_mut<T>(data, lo);
            dec p_pivot_final = std::ptr::add_mut<T>(data, pivot_final);
            dec tmp_final = std::ptr::read<T>(p_lo_final as *T);
            std::ptr::copy<T>(p_pivot_final as *T, p_lo_final, 1 as u64);
            std::ptr::write<T>(p_pivot_final, tmp_final);
        }
    }
    return pivot_final;
}

// Introsort recursive core
fn introsort_by_rec<T>(data: *rw T, lo: u64, hi: u64, depth_limit: u64, compare: fn(&T, &T) -> i32) {
    dec n = hi - lo;
    if n <= (1 as u64) { return; }

    // Small subarrays: insertion sort
    if n <= (16 as u64) {
        insertion_sort_by<T>(data, lo, hi, compare);
        return;
    }

    // Depth limit exceeded: heapsort fallback
    if depth_limit == (0 as u64) {
        heapsort_by<T>(data, lo, hi, compare);
        return;
    }

    // Partition and recurse
    dec pivot = partition_by<T>(data, lo, hi, compare);
    dec new_depth = depth_limit - (1 as u64);
    introsort_by_rec<T>(data, lo, pivot, new_depth, compare);
    introsort_by_rec<T>(data, pivot + (1 as u64), hi, new_depth, compare);
}

// Public sort_by: in-place introsort with O(n log n) worst-case guarantee
export fn slice_sort_by<T>(s: &rw [T], compare: fn(&T, &T) -> i32) {
    dec slen = s.len as u64;
    if slen <= (1 as u64) { return; }
    dec depth_limit = (2 as u64) * floor_log2(slen);
    introsort_by_rec<T>(s.data as *rw T, 0 as u64, slen, depth_limit, compare);
}

// Helper: comparison function for i32 using Ord
fn cmp_i32(a: &i32, b: &i32) -> i32 {
    if *a < *b { return 0 - 1; }
    if *a > *b { return 1; }
    return 0;
}

// Public sort for i32 slices (delegates to generic slice_sort)
export fn slice_sort_i32(s: &rw [i32]) {
    std::slice::slice_sort<i32>(s);
}

// =========================================================================
// Generic Slice Sorting: Introsort for T: Ord
// =========================================================================

fn insertion_sort_ord<T: std::Ord>(data: *rw T, lo: u64, hi: u64) {
    dec rw i = lo + (1 as u64);
    while i < hi {
        unsafe {
            dec rw j = i;
            dec tmp = std::ptr::read<T>(std::ptr::add<T>(data as *T, j) as *T);
            dec rw cont = true;
            while cont {
                if j <= lo {
                    cont = false;
                } else {
                    dec prev = std::ptr::add<T>(data as *T, j - (1 as u64));
                    dec c = (*prev).cmp(&tmp);
                    if c > 0 {
                        dec dest = std::ptr::add_mut<T>(data, j);
                        std::ptr::copy<T>(prev, dest, 1 as u64);
                        j = j - (1 as u64);
                    } else {
                        cont = false;
                    }
                }
            }
            std::ptr::write<T>(std::ptr::add_mut<T>(data, j), tmp);
        }
        i = i + (1 as u64);
    }
}

fn sift_down_ord<T: std::Ord>(data: *rw T, lo: u64, root: u64, end: u64) {
    dec rw cur = root;
    while ((2 as u64) * cur + (1 as u64)) < end {
        dec rw child = (2 as u64) * cur + (1 as u64);
        dec right = child + (1 as u64);
        unsafe {
            if right < end {
                dec p_child = std::ptr::add<T>(data as *T, lo + child);
                dec p_right = std::ptr::add<T>(data as *T, lo + right);
                if (*p_child).cmp(&*p_right) < 0 {
                    child = right;
                }
            }
            dec p_cur = std::ptr::add_mut<T>(data, lo + cur);
            dec p_ch = std::ptr::add_mut<T>(data, lo + child);
            if (*p_cur).cmp(&*p_ch) < 0 {
                dec tmp = std::ptr::read<T>(p_cur as *T);
                std::ptr::copy<T>(p_ch as *T, p_cur, 1 as u64);
                std::ptr::write<T>(p_ch, tmp);
                cur = child;
            } else {
                return;
            }
        }
    }
}

fn heapsort_ord<T: std::Ord>(data: *rw T, lo: u64, hi: u64) {
    dec n = hi - lo;
    if n <= (1 as u64) { return; }

    dec rw start_idx = n / (2 as u64);
    while start_idx > (0 as u64) {
        start_idx = start_idx - (1 as u64);
        sift_down_ord<T>(data, lo, start_idx, n);
    }

    dec rw end_idx = n - (1 as u64);
    while end_idx > (0 as u64) {
        unsafe {
            dec p_root = std::ptr::add_mut<T>(data, lo);
            dec p_end = std::ptr::add_mut<T>(data, lo + end_idx);
            dec tmp = std::ptr::read<T>(p_root as *T);
            std::ptr::copy<T>(p_end as *T, p_root, 1 as u64);
            std::ptr::write<T>(p_end, tmp);
        }
        sift_down_ord<T>(data, lo, 0 as u64, end_idx);
        end_idx = end_idx - (1 as u64);
    }
}

fn median3_ord<T: std::Ord>(data: *rw T, a: u64, b: u64, c: u64) -> u64 {
    unsafe {
        dec pa = std::ptr::add<T>(data as *T, a);
        dec pb = std::ptr::add<T>(data as *T, b);
        dec pc = std::ptr::add<T>(data as *T, c);

        dec ab = (*pa).cmp(&*pb);
        dec ac = (*pa).cmp(&*pc);
        dec bc = (*pb).cmp(&*pc);

        if ab < 0 {
            if bc < 0 { return b; }
            if ac < 0 { return c; }
            return a;
        } else {
            if ac < 0 { return a; }
            if bc < 0 { return c; }
            return b;
        }
    }
}

fn partition_ord<T: std::Ord>(data: *rw T, lo: u64, hi: u64) -> u64 {
    dec mid = median3_ord<T>(data, lo, lo + ((hi - lo) / (2 as u64)), hi - (1 as u64));
    unsafe {
        dec p_lo_swap = std::ptr::add_mut<T>(data, lo);
        dec p_mid_swap = std::ptr::add_mut<T>(data, mid);
        dec tmp_swap = std::ptr::read<T>(p_lo_swap as *T);
        std::ptr::copy<T>(p_mid_swap as *T, p_lo_swap, 1 as u64);
        std::ptr::write<T>(p_mid_swap, tmp_swap);
    }

    dec rw store = lo + (1 as u64);
    dec rw i = lo + (1 as u64);
    while i < hi {
        unsafe {
            dec p_i = std::ptr::add<T>(data as *T, i);
            dec p_pivot = std::ptr::add<T>(data as *T, lo);
            if (*p_i).cmp(&*p_pivot) < 0 {
                if i != store {
                    dec p_store = std::ptr::add_mut<T>(data, store);
                    dec p_i_mut = std::ptr::add_mut<T>(data, i);
                    dec tmp = std::ptr::read<T>(p_store as *T);
                    std::ptr::copy<T>(p_i_mut as *T, p_store, 1 as u64);
                    std::ptr::write<T>(p_i_mut, tmp);
                }
                store = store + (1 as u64);
            }
        }
        i = i + (1 as u64);
    }

    dec pivot_final = store - (1 as u64);
    if lo != pivot_final {
        unsafe {
            dec p_lo_final = std::ptr::add_mut<T>(data, lo);
            dec p_pivot_final = std::ptr::add_mut<T>(data, pivot_final);
            dec tmp_final = std::ptr::read<T>(p_lo_final as *T);
            std::ptr::copy<T>(p_pivot_final as *T, p_lo_final, 1 as u64);
            std::ptr::write<T>(p_pivot_final, tmp_final);
        }
    }
    return pivot_final;
}

fn introsort_ord_rec<T: std::Ord>(data: *rw T, lo: u64, hi: u64, depth_limit: u64) {
    dec n = hi - lo;
    if n <= (1 as u64) { return; }

    if n <= (16 as u64) {
        insertion_sort_ord<T>(data, lo, hi);
        return;
    }

    if depth_limit == (0 as u64) {
        heapsort_ord<T>(data, lo, hi);
        return;
    }

    dec pivot = partition_ord<T>(data, lo, hi);
    dec new_depth = depth_limit - (1 as u64);
    introsort_ord_rec<T>(data, lo, pivot, new_depth);
    introsort_ord_rec<T>(data, pivot + (1 as u64), hi, new_depth);
}

// Public generic sort for slices whose elements implement Ord
export fn slice_sort<T: std::Ord>(s: &rw [T]) {
    dec slen = s.len as u64;
    if slen <= (1 as u64) { return; }
    dec depth_limit = (2 as u64) * floor_log2(slen);
    introsort_ord_rec<T>(s.data as *rw T, 0 as u64, slen, depth_limit);
}

// Linear search for an element in a slice
export fn slice_contains<T: std::Eq>(s: &[T], value: &T) -> bool {
    dec slen = s.len as u64;
    dec rw i: u64 = 0 as u64;
    while i < slen {
        if s[i].eq(value) {
            return true;
        }
        i = i + (1 as u64);
    }
    return false;
}

// Binary search on a sorted slice
export fn slice_binary_search<T: std::Ord>(s: &[T], value: &T) -> std::Option<u64> {
    dec slen = s.len as u64;
    if slen == (0 as u64) {
        return std::Option::None;
    }
    dec rw lo: u64 = 0 as u64;
    dec rw hi: u64 = slen;
    while lo < hi {
        dec mid = lo + ((hi - lo) / (2 as u64));
        dec cmp_res = s[mid].cmp(value);
        if cmp_res == 0 {
            return std::Option::Some(mid);
        } else if cmp_res < 0 {
            lo = mid + (1 as u64);
        } else {
            hi = mid;
        }
    }
    return std::Option::None;
}

// Check if slice starts with the given prefix
export fn slice_starts_with<T: std::Eq>(s: &[T], prefix: &[T]) -> bool {
    dec s_len = s.len as u64;
    dec p_len = prefix.len as u64;
    if p_len > s_len { return false; }
    dec rw i: u64 = 0 as u64;
    while i < p_len {
        if s[i].eq(&prefix[i]) == false {
            return false;
        }
        i = i + (1 as u64);
    }
    return true;
}

// Check if slice ends with the given suffix
export fn slice_ends_with<T: std::Eq>(s: &[T], suffix: &[T]) -> bool {
    dec s_len = s.len as u64;
    dec suf_len = suffix.len as u64;
    if suf_len > s_len { return false; }
    dec offset = s_len - suf_len;
    dec rw i: u64 = 0 as u64;
    while i < suf_len {
        if s[offset + i].eq(&suffix[i]) == false {
            return false;
        }
        i = i + (1 as u64);
    }
    return true;
}


// Generic slice copy for std::Copy types
export fn slice_copy_from_slice<T: std::Copy>(dst: &rw [T], src: &[T]) {
    dec dst_len = dst.len as u64;
    dec src_len = src.len as u64;
    if dst_len != src_len {
        __luna_panic_default();
    }
    dec rw i: u64 = 0 as u64;
    while i < dst_len {
        dst[i] = src[i];
        i = i + (1 as u64);
    }
}

// Fill slice with a cloned value (takes value by value)
// - Clones value for the first slen - 1 slots
// - Moves original value into the final slot (or drops if empty)
export fn slice_fill<T: std::Clone>(s: &rw [T], value: T) {
    dec slen = s.len as u64;
    if slen == (0 as u64) {
        return;
    }
    dec rw i: u64 = 0 as u64;
    while i < slen - (1 as u64) {
        s[i] = value.clone();
        i = i + (1 as u64);
    }
    s[slen - (1 as u64)] = value;
}

// std::Copy elements between equal-length slices (i32 specialization)
export fn slice_copy_i32(dst: &rw [i32], src: &[i32]) {
    std::slice::slice_copy_from_slice<i32>(dst, src);
}

// Fill a slice with a value (i32 specialization)
export fn slice_fill_i32(s: &rw [i32], value: i32) {
    std::slice::slice_fill<i32>(s, value);
}

extern fn __luna_panic_default();

    }
}

