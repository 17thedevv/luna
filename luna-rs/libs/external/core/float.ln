export fn cos(x: f64) -> f64 { return c_cos(x); }
export fn tan(x: f64) -> f64 { return c_tan(x); }
export fn asin(x: f64) -> f64 { return c_asin(x); }
export fn acos(x: f64) -> f64 { return c_acos(x); }
export fn atan(x: f64) -> f64 { return c_atan(x); }
export fn atan2(y: f64, x: f64) -> f64 { return c_atan2(y, x); }
export fn pow(base: f64, exp: f64) -> f64 { return c_pow(base, exp); }
export fn exp(x: f64) -> f64 { return c_exp(x); }
export fn log(x: f64) -> f64 { return c_log(x); }
export fn log2(x: f64) -> f64 { return c_log2(x); }
export fn log10(x: f64) -> f64 { return c_log10(x); }
export fn floor(x: f64) -> f64 { return c_floor(x); }
export fn ceil(x: f64) -> f64 { return c_ceil(x); }
export fn round(x: f64) -> f64 { return c_round(x); }
export fn trunc(x: f64) -> f64 { return c_trunc(x); }

export fn sqrtf(x: f32) -> f32 { return c_sqrtf(x); }
export fn sinf(x: f32) -> f32 { return c_sinf(x); }
export fn cosf(x: f32) -> f32 { return c_cosf(x); }
