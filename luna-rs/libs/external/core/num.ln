    if b == (0 as u8) { return std::Option::None; }
    return std::Option::Some(a / b);
}
export fn saturating_add_u8(a: u8, b: u8) -> u8 {
    dec max_val: u8 = 255 as u8;
    if max_val - b < a { return max_val; }
    return a + b;
}
