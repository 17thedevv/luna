import <ptr>;

export module std {
    export module mem {
    // NOTE: `slice_from_raw_parts` and `slice_from_raw_parts_mut` are unsafe intrinsic boundaries
    // bridging raw pointers to fat-pointer slices. They must NOT be treated as a precedent for safe
    // reference construction without explicit lifetime provenance contracts.
    export unsafe fn slice_from_raw_parts<T>(ptr: *T, len: u64) -> &[T];
    export unsafe fn slice_from_raw_parts_mut<T>(ptr: *rw T, len: u64) -> &rw [T];
    
    export unsafe fn copy(src: *u8, dst: *rw u8, bytes: u64) {
        dec rw i: u64 = 0 as u64;
        while i < bytes {
            dec s = (src as u64 + i) as *u8;
            dec d = (dst as u64 + i) as *rw u8;
            *d = *s;
            i = i + (1 as u64);
        }
    }
    
    export unsafe fn set(dst: *rw u8, val: u8, bytes: u64) {
        dec rw i: u64 = 0 as u64;
        while i < bytes {
            dec d = (dst as u64 + i) as *rw u8;
            *d = val;
            i = i + (1 as u64);
        }
    }
    
    export unsafe fn zero(dst: *rw u8, bytes: u64) {
        set(dst, 0 as u8, bytes);
    }
    
    export fn size_of<T>() -> u64 {
        return sizeof(T) as u64;
    }
    
    export fn align_of<T>() -> u64 {
        return alignof(T) as u64;
    }

    /// Swaps the values of two mutable references without invalidating either.
    /// Safe wrapper around `std::ptr::swap`: compiler borrowck guarantees `a` and `b`
    /// cannot alias simultaneously as mutable references.
    export fn swap<T>(a: &rw T, b: &rw T) {
        unsafe {
            std::ptr::swap<T>(a as *rw T, b as *rw T);
        }
    }

    /// Replaces the value at `dest` with `src`, returning the previous value.
    /// Move semantics: transfers ownership without drop.
    export fn replace<T>(dest: &rw T, src: T) -> T {
        unsafe {
            dec old = std::ptr::read<T>(dest as *T);
            std::ptr::write<T>(dest as *rw T, src);
            return old;
        }
    }

    export struct Layout {
        private size_: u64,
        private align_: u64,
    };

    export fn layout_for_type<T>() -> Layout {
        return Layout {
            size_: size_of<T>(),
            align_: align_of<T>(),
        };
    }

    export fn layout_from_size_align_unchecked(size: u64, align: u64) -> Layout {
        return Layout {
            size_: size,
            align_: align,
        };
    }

    export fn layout_is_valid_align(align: u64) -> bool {
        if align == (0 as u64) {
            return false;
        }
        return (align & (align - (1 as u64))) == (0 as u64);
    }

    impl Layout {
        export fn size(self: &Self) -> u64 {
            return self.size_;
        }

        export fn align(self: &Self) -> u64 {
            return self.align_;
        }

        export fn is_valid(self: &Self) -> bool {
            if self.align_ == (0 as u64) {
                return false;
            }
            return (self.align_ & (self.align_ - (1 as u64))) == (0 as u64);
        }
    }
}
}
