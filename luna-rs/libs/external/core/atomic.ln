import <ptr>;
import <mem>;

export extern fn __luna_atomic_load_u64(ptr: *u64) -> u64;
export extern fn __luna_atomic_store_u64(ptr: *rw u64, val: u64);
export extern fn __luna_atomic_add_u64(ptr: *rw u64, val: u64) -> u64;
export extern fn __luna_atomic_sub_u64(ptr: *rw u64, val: u64) -> u64;
export extern fn __luna_atomic_cas_u64(ptr: *rw u64, expected: u64, desired: u64) -> u64;
export extern fn __luna_atomic_swap_u64(ptr: *rw u64, val: u64) -> u64;

export extern fn __luna_atomic_load_u32(ptr: *u32) -> u32;
export extern fn __luna_atomic_store_u32(ptr: *rw u32, val: u32);
export extern fn __luna_atomic_add_u32(ptr: *rw u32, val: u32) -> u32;
export extern fn __luna_atomic_sub_u32(ptr: *rw u32, val: u32) -> u32;
export extern fn __luna_atomic_cas_u32(ptr: *rw u32, expected: u32, desired: u32) -> u32;
export extern fn __luna_atomic_swap_u32(ptr: *rw u32, val: u32) -> u32;

export module std {
    export enum Ordering {
        Relaxed,
        Acquire,
        Release,
        AcqRel,
        SeqCst,
    }

    // =========================================================================
    // AtomicBool
    // =========================================================================
    export struct AtomicBool {
        private value: u32,
    };

    export fn atomic_bool_new(val: bool) -> AtomicBool {
        dec rw raw: u32 = 0 as u32;
        if val {
            raw = 1 as u32;
        }
        return AtomicBool { value: raw };
    }

    impl AtomicBool {
        export fn new(val: bool) -> AtomicBool {
            return atomic_bool_new(val);
        }

        export fn load(self: &Self) -> bool {
            dec p = &self.value as *u32;
            unsafe {
                dec v = __luna_atomic_load_u32(p);
                return v != (0 as u32);
            }
        }

        export fn store(self: &Self, val: bool) {
            dec p_imm = &self.value as *u32;
            dec p_mut = p_imm as *rw u32;
            dec rw raw: u32 = 0 as u32;
            if val {
                raw = 1 as u32;
            }
            unsafe {
                __luna_atomic_store_u32(p_mut, raw);
            }
        }

        export fn swap(self: &Self, val: bool) -> bool {
            dec p_imm = &self.value as *u32;
            dec p_mut = p_imm as *rw u32;
            dec rw raw: u32 = 0 as u32;
            if val {
                raw = 1 as u32;
            }
            unsafe {
                dec old = __luna_atomic_swap_u32(p_mut, raw);
                return old != (0 as u32);
            }
        }

        export fn compare_exchange(self: &Self, expected: bool, desired: bool) -> bool {
            dec p_imm = &self.value as *u32;
            dec p_mut = p_imm as *rw u32;
            dec rw exp: u32 = 0 as u32;
            if expected {
                exp = 1 as u32;
            }
            dec rw des: u32 = 0 as u32;
            if desired {
                des = 1 as u32;
            }
            unsafe {
                dec prev = __luna_atomic_cas_u32(p_mut, exp, des);
                return prev != (0 as u32);
            }
        }
    }

