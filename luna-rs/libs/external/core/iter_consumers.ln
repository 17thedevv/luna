import <__lang_option>;
import <__lang_iterator>;
import <cmp>;

export module std {
    export module iter {

// =========================================================================
// Terminal Consumers: fold, count, for_each, any, all, find
// =========================================================================

export fn iter_fold<FoldIter: std::Iterator<FoldItem>, FoldItem, B>(iter: FoldIter, init: B, f: fn(B, FoldItem) -> B) -> B {
    dec rw it = iter;
    dec rw acc = init;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            std::Option::Some(x) -> {
                dec f_ptr = f;
                acc = f_ptr(acc, x);
            },
            std::Option::None -> {
                running = false;
            },
        }
    }
    return acc;
}

export fn iter_count<CountIter: std::Iterator<CountItem>, CountItem>(iter: CountIter) -> u64 {
    dec rw it = iter;
    dec rw count: u64 = 0 as u64;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            std::Option::Some(_) -> {
                count = count + (1 as u64);
            },
            std::Option::None -> {
                running = false;
            },
        }
    }
    return count;
}

export fn iter_for_each<EachIter: std::Iterator<EachItem>, EachItem>(iter: EachIter, f: fn(EachItem)) {
    dec rw it = iter;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            std::Option::Some(x) -> {
                dec f_ptr = f;
                f_ptr(x);
            },
            std::Option::None -> {
                running = false;
            },
        }
    }
}

export fn iter_any<AnyIter: std::Iterator<AnyItem>, AnyItem>(iter: AnyIter, pred: fn(AnyItem) -> bool) -> bool {
    dec rw it = iter;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            std::Option::Some(x) -> {
                dec p_ptr = pred;
                if p_ptr(x) {
                    return true;
                }
            },
            std::Option::None -> {
                running = false;
            },
        }
    }
    return false;
}

export fn iter_all<AllIter: std::Iterator<AllItem>, AllItem>(iter: AllIter, pred: fn(AllItem) -> bool) -> bool {
    dec rw it = iter;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            std::Option::Some(x) -> {
                dec p_ptr = pred;
                if p_ptr(x) {
                } else {
                    return false;
                }
            },
            std::Option::None -> {
                running = false;
            },
        }
    }
    return true;
}

export fn iter_find<FindIter: std::Iterator<FindItem>, FindItem>(iter: FindIter, pred: fn(FindItem) -> bool) -> std::Option<FindItem> {
    dec rw it = iter;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            std::Option::Some(x) -> {
                dec p_ptr = pred;
                if p_ptr(x) {
                    return std::Option::Some(x);
                }
            },
            std::Option::None -> {
                running = false;
            },
        }
    }
    return std::Option::None;
}

export fn iter_position<PosIter: std::Iterator<PosItem>, PosItem>(iter: PosIter, pred: fn(PosItem) -> bool) -> std::Option<u64> {
    dec rw it = iter;
    dec rw idx: u64 = 0 as u64;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            std::Option::Some(x) -> {
                dec p_ptr = pred;
                if p_ptr(x) {
                    return std::Option::Some(idx);
                }
                idx = idx + (1 as u64);
            },
            std::Option::None -> {
                running = false;
            },
        }
    }
    return std::Option::None;
}

export fn iter_nth<NthIter: std::Iterator<NthItem>, NthItem>(iter: NthIter, n: u64) -> std::Option<NthItem> {
    dec rw it = iter;
    dec rw idx: u64 = 0 as u64;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            std::Option::Some(x) -> {
                if idx == n {
                    return std::Option::Some(x);
                }
                idx = idx + (1 as u64);
            },
            std::Option::None -> {
                running = false;
            },
        }
    }
    return std::Option::None;
}

export fn iter_last<LastIter: std::Iterator<LastItem>, LastItem>(iter: LastIter) -> std::Option<LastItem> {
    dec rw it = iter;
    dec rw last: std::Option<LastItem> = std::Option::None;
    dec rw running = true;
    while running {
        dec opt = it.next();
        match opt {
            std::Option::Some(x) -> {
                last = std::Option::Some(x);
            },
            std::Option::None -> {
                running = false;
            },
        }
    }
    return last;
}

export fn iter_sum_u8<SumIter: std::Iterator<u8>>(iter: SumIter) -> u8 {
    dec rw it = iter;
    dec rw acc: u8 = 0 as u8;
    while true {
        dec opt = it.next();
        match opt {
            std::Option::Some(x) -> { acc = acc + x; },
            std::Option::None -> { break; },
        }
    }
    return acc;
}

