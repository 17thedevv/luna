struct UserIter {
    current: i32,
    limit: i32,
};

impl std::Iterator<i32> for UserIter {
    fn next(self: &rw Self) -> std::Option<i32> {
        if self.current < self.limit {
            dec value = self.current;
            self.current = self.current + 1;
            return std::Option::Some(value);
        }
        return std::Option::None;
    }
}

impl std::IntoIterator<i32, UserIter> for UserIter {
    fn into_iter(self: Self) -> UserIter {
        return self;
    }
}

fn main() -> i32 {
    dec source = UserIter { current: 4, limit: 6 };
    dec rw iter = source.into_iter();
    match iter.next() {
        std::Option::Some(value) -> { if value != 4 { return 1; } },
        std::Option::None -> { return 2; },
    }
    match iter.next() {
        std::Option::Some(value) -> { if value != 5 { return 3; } },
        std::Option::None -> { return 4; },
    }
    match iter.next() {
        std::Option::Some(value) -> { return 5; },
        std::Option::None -> {},
    }
    return 0;
}
