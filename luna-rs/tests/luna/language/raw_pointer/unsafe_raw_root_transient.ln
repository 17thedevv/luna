fn consume(value: &i32) -> i32 {
    return *value;
}

unsafe fn read_unknown(pointer: *i32) -> i32 {
    unsafe {
        dec local = &*pointer;
        return consume(local);
    }
}

fn main() {
    dec value = 7;
    unsafe {
        dec pointer = &value as *i32;
        if read_unknown(pointer) != 7 { return; }
    }
}
