import <box>;
import <vec>;
import <string>;
import <hashmap>;
import <hashset>;
import <iter_collect>;

fn main() -> i32 {
    dec owned_box: std::Box<i32> = std::box_new<i32>(7);

    dec values: std::Vec<i32> = std::vec_new<i32>();

    dec text: std::String = std::string_new();

    dec map: std::HashMap<i32, i32> = std::hashmap_new<i32, i32>();

    dec set: std::HashSet<i32> = std::hashset_new<i32>();

    if *owned_box.as_ref() != 7 {
        return 1;
    }
    if values.len() != (0 as u64) {
        return 2;
    }
    if text.len() != (0 as u64) {
        return 3;
    }
    if root_map.len() != (0 as u64) || std_map.len() != (0 as u64) {
        return 4;
    }
    if root_set.len() != (0 as u64) || std_set.len() != (0 as u64) {
        return 5;
    }
    return 0;
}
