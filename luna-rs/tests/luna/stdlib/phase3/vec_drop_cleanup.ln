import <vec>;
import <ptr>;

struct Tracker {
    count: *rw u64,
};

impl std::Drop for Tracker {
    fn drop(self: &rw Self) {
        unsafe {
            dec current = std::ptr::read(self.count as *u64);
            std::ptr::write(self.count, current + (1 as u64));
        }
    }
}

fn consume_one<I: std::Iterator<Tracker>>(iter: I) {
    dec rw it = iter;
    match it.next() {
        std::Option::Some(item) -> {},
        std::Option::None -> {},
    }
}

fn main() -> i32 {
    dec rw drops = 0 as u64;
    {
        dec rw tracked = std::vec_new<Tracker>();
        tracked.push(Tracker { count: &rw drops as *rw u64 });
        tracked.push(Tracker { count: &rw drops as *rw u64 });
        tracked.push(Tracker { count: &rw drops as *rw u64 });
        consume_one(tracked.into_iter());
    }
    if drops != (3 as u64) {
        return 1;
    }
    return 0;
}
