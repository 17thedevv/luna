import <fmt>;
import <string>;
import <io>;

fn append<T: std::fmt::Display>(value: T, output: &rw std::String) {
    value.fmt(output).unwrap();
    output.push_char('|');
}

fn main() -> i32 {
    dec rw output = std::string_new();

    dec i8_min = (0 as i8) - (127 as i8) - (1 as i8);
    append(i8_min, &rw output);
    append((0 as i8) - (1 as i8), &rw output);
    append(9 as i8, &rw output);
    append(10 as i8, &rw output);
    append(11 as i8, &rw output);
    append(0 as i8, &rw output);
    append(127 as i8, &rw output);
    append(0 as u8, &rw output);
    append(9 as u8, &rw output);
    append(10 as u8, &rw output);
    append(11 as u8, &rw output);
    append(255 as u8, &rw output);

    dec i16_min = (0 as i16) - (32767 as i16) - (1 as i16);
    append(i16_min, &rw output);
    append((0 as i16) - (1 as i16), &rw output);
    append(9 as i16, &rw output);
    append(10 as i16, &rw output);
    append(11 as i16, &rw output);
    append(0 as i16, &rw output);
    append(32767 as i16, &rw output);
    append(0 as u16, &rw output);
    append(9 as u16, &rw output);
    append(10 as u16, &rw output);
    append(11 as u16, &rw output);
    append(999 as u16, &rw output);
    append(1000 as u16, &rw output);
    append(1001 as u16, &rw output);
    append(65535 as u16, &rw output);

    dec i32_min = (0 as i32) - (2147483647 as i32) - (1 as i32);
    append(i32_min, &rw output);
    append((0 as i32) - (1 as i32), &rw output);
    append(9 as i32, &rw output);
    append(10 as i32, &rw output);
    append(11 as i32, &rw output);
    append(0 as i32, &rw output);
    append(2147483647 as i32, &rw output);
    append(0 as u32, &rw output);
    append(9 as u32, &rw output);
    append(10 as u32, &rw output);
    append(11 as u32, &rw output);
    append(999999999 as u32, &rw output);
    append(1000000000 as u32, &rw output);
    append(1000000001 as u32, &rw output);
    append(4294967295 as u32, &rw output);

    dec i64_min = (0 as i64) - (9223372036854775807 as i64) - (1 as i64);
    append(i64_min, &rw output);
    append((0 as i64) - (1 as i64), &rw output);
    append(9 as i64, &rw output);
    append(10 as i64, &rw output);
    append(11 as i64, &rw output);
    append(0 as i64, &rw output);
    append(9223372036854775807 as i64, &rw output);
    append(0 as u64, &rw output);
    append(9 as u64, &rw output);
    append(10 as u64, &rw output);
    append(11 as u64, &rw output);
    append(999999999999 as u64, &rw output);
    append(1000000000000 as u64, &rw output);
    append(1000000000001 as u64, &rw output);
    append(18446744073709551615 as u64, &rw output);

    dec i128_half = (1 as i128) << (126 as i128);
    dec i128_min = (0 as i128) - i128_half - i128_half;
    dec i128_max = (i128_half - (1 as i128)) + i128_half;
    append(i128_min, &rw output);
    append((0 as i128) - (1 as i128), &rw output);
    append(9 as i128, &rw output);
    append(10 as i128, &rw output);
    append(11 as i128, &rw output);
    append(0 as i128, &rw output);
    append(i128_max, &rw output);
    append(0 as u128, &rw output);
    append(9 as u128, &rw output);
    append(10 as u128, &rw output);
    append(11 as u128, &rw output);
    append(999 as u128, &rw output);
    append(1000 as u128, &rw output);
    append(1001 as u128, &rw output);
    dec u128_max = (((1 as u128) << (127 as u128)) - (1 as u128)) * (2 as u128) + (1 as u128);
    append(u128_max, &rw output);

    dec isize_min = (0 as isize) - (9223372036854775807 as isize) - (1 as isize);
    append(isize_min, &rw output);
    append((0 as isize) - (1 as isize), &rw output);
    append(9 as isize, &rw output);
    append(10 as isize, &rw output);
    append(11 as isize, &rw output);
    append(0 as isize, &rw output);
    append(9223372036854775807 as isize, &rw output);
    append(0 as usize, &rw output);
    append(9 as usize, &rw output);
    append(10 as usize, &rw output);
    append(11 as usize, &rw output);
    append(18446744073709551615 as usize, &rw output);

    std::io::println(output.as_bytes());
    return 0;
}
