import <mem>;
import <ptr>;

struct Point {
    x: i32,
    y: i32,
};

fn main() -> i32 {
    // 1. Test std::mem::Layout
    dec layout_i32 = std::mem::layout_for_type<i32>();
    if layout_i32.size() != (4 as u64) {
        return 1;
    }
    if layout_i32.align() != (4 as u64) {
        return 2;
    }
    if layout_i32.is_valid() == false {
        return 3;
    }

    dec layout_point = std::mem::layout_for_type<Point>();
    if layout_point.size() != (8 as u64) {
        return 4;
    }
    if layout_point.align() != (4 as u64) {
        return 5;
    }

    // Alignment must be power of 2
    if std::mem::layout_is_valid_align(0 as u64) == true {
        return 6;
    }
    if std::mem::layout_is_valid_align(3 as u64) == true {
        return 7;
    }
    if std::mem::layout_is_valid_align(8 as u64) == false {
        return 8;
    }

    // 2. Test std::ptr::NonNull
    dec rw val: i32 = 12345;
    dec ptr_raw = &rw val as *rw i32;
    unsafe {
        dec nn = std::ptr::nonnull_new_unchecked<i32>(ptr_raw);
        if nn.is_null() == true {
            return 9;
        }
        if *nn.as_ref() != 12345 {
            return 10;
        }

        // Mutate via NonNull::as_mut
        dec rw nn_rw = nn;
        *nn_rw.as_mut() = 54321;
        if val != 54321 {
            return 11;
        }

        // Test null check
        dec null_ptr = 0 as u64 as *rw i32;
        dec null_nn = std::ptr::nonnull_new_unchecked<i32>(null_ptr);
        if null_nn.is_null() == false {
            return 12;
        }
    }

    return 0;
}
