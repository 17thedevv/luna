import <fmt>;
import <string>;
import <io>;

fn main() -> i32 {
    dec rw output = std::string_from_str("prefix:");
    dec empty = std::string_new();
    std::fmt::Display::fmt(&empty, &rw output).unwrap();

    dec lower = 'é';
    dec two_byte_max = '߿';
    dec three_byte_min = 'ࠀ';
    dec private_use = '';
    dec four_byte_min = '𐀀';
    dec unicode_max = '􏿿';
    dec nul = '\0';

    std::fmt::Display::fmt(&lower, &rw output).unwrap();
    std::fmt::Display::fmt(&two_byte_max, &rw output).unwrap();
    std::fmt::Display::fmt(&three_byte_min, &rw output).unwrap();
    std::fmt::Display::fmt(&private_use, &rw output).unwrap();
    std::fmt::Display::fmt(&four_byte_min, &rw output).unwrap();
    std::fmt::Display::fmt(&unicode_max, &rw output).unwrap();
    std::fmt::Display::fmt(&nul, &rw output).unwrap();

    dec text = std::string_from_str("多字");
    std::fmt::Display::fmt(&text, &rw output).unwrap();
    std::io::println(output.as_bytes());
    return 0;
}
