import <result>;
import <clone>;
import <hash>;
import <cmp>;
import <copy>;
import <default>;
import <convert>;
import <float>;
import <num>;
import <panic>;

struct Meter { value: i32 };

impl std::Clone for Meter {
    fn clone(self: &Self) -> Self { return Meter { value: self.value }; }
}

impl std::Hash for Meter {
    fn hash(self: &Self) -> u64 { return self.value as u64; }
}

impl std::Eq for Meter {
    fn eq(self: &Self, other: &Self) -> bool { return self.value == other.value; }
}

impl std::Ord for Meter {
    fn cmp(self: &Self, other: &Self) -> i32 {
        if self.value < other.value { return -1; }
        if self.value > other.value { return 1; }
        return 0;
    }
}

fn require_clone<T: std::Clone>(value: &T) -> T { return value.clone(); }
fn require_hash<T: std::Hash>(value: &T) -> u64 { return value.hash(); }
fn require_eq<T: std::Eq>(left: &T, right: &T) -> bool { return left.eq(right); }
fn require_ord<T: std::Ord>(left: &T, right: &T) -> i32 { return left.cmp(right); }
fn convert_widen<T: std::Convert<i64>>(value: T) -> i64 { return value.convert(); }

fn main() -> i32 {
    dec result: std::Result<i32, i32> = std::Result::Ok(7);
    match result {
        std::Result::Ok(value) -> { if value != 7 { return 1; } },
        std::Result::Err(_) -> { return 2; },
    }

    dec meter = Meter { value: 9 };
    dec copied = require_clone(&meter);
    if copied.value != 9 { return 3; }
    if require_hash(&meter) != 9 as u64 { return 4; }
    if require_eq(&meter, &copied) == false { return 5; }
    if require_ord(&meter, &copied) != 0 { return 6; }
    if convert_widen(42 as u8) != (42 as i64) { return 7; }

    dec zero: i32 = std::Default::default();
    if zero != 0 { return 8; }
    match std::checked_add_i32(20, 22) {
        std::Option::Some(sum) -> { if sum != 42 { return 9; } },
        std::Option::None -> { return 9; },
    }

    dec absolute = ((0.0 as f32) - (1.5 as f32)).abs();
    if absolute != (1.5 as f32) { return 10; }
    if std::f32_nan().is_nan() == false { return 11; }
    if std::f64_from_bits(std::f64_to_bits(1.5 as f64)) != (1.5 as f64) { return 12; }

    return 0;
}
