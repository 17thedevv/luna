import <fmt>;
import <string>;
import <io>;

fn append<T: std::fmt::Display>(value: T, output: &rw std::String) {
    value.fmt(output).unwrap();
    output.push_char('|');
}

fn main() -> i32 {
    dec rw output = std::string_new();
    append(127 as i8, &rw output);
    append(-128 as i8, &rw output);
    append(32767 as i16, &rw output);
    append(-32768 as i16, &rw output);
    append(2147483647 as i32, &rw output);
    append(-2147483647 as i32 - (1 as i32), &rw output);
    append(9223372036854775807i64, &rw output);
    dec i64_min = (0 as i64) - (9223372036854775807i64) - (1 as i64);
    append(i64_min, &rw output);
    append(18446744073709551615u64, &rw output);
    dec u128_max = (((1 as u128) << (127 as u128)) - (1 as u128)) * (2 as u128) + (1 as u128);
    append(u128_max, &rw output);
    dec i128_min = -((1 as i128) << (126 as i128)) - ((1 as i128) << (126 as i128));
    dec i128_max = ((1 as i128) << (126 as i128)) + ((1 as i128) << (126 as i128)) - (1 as i128);
    append(i128_min, &rw output);
    append(i128_max, &rw output);
    append(18446744073709551615usize, &rw output);
    dec isize_min = (0 as isize) - (9223372036854775807isize) - (1 as isize);
    append(isize_min, &rw output);
    std::io::println(output.as_bytes());
    return 0;
}
