import <float>;
import <panic>;

fn assert_approx_eq64(a: f64, b: f64, eps: f64) {
    dec diff = a - b;
    dec rw abs_diff = diff;
    if diff < 0.0 {
        abs_diff = 0.0 - diff;
    }
    if abs_diff > eps {
        std::panic();
    }
}

fn assert_approx_eq32(a: f32, b: f32, eps: f32) {
    dec diff = a - b;
    dec rw abs_diff = diff;
    if diff < (0.0 as f32) {
        abs_diff = (0.0 as f32) - diff;
    }
    if abs_diff > eps {
        std::panic();
    }
}

fn main() {
    // 1. Constants
    dec pi_val = std::pi();
    dec e_val = std::e();
    assert_approx_eq64(pi_val, 3.141592653589793, 0.000000000001);
    assert_approx_eq64(e_val, 2.718281828459045, 0.000000000001);

    // 2. Direct standalone calls (f64)
    assert_approx_eq64(std::sqrt(4.0), 2.0, 0.0001);
    assert_approx_eq64(std::sqrt(9.0), 3.0, 0.0001);
    assert_approx_eq64(std::sin(0.0), 0.0, 0.0001);
    assert_approx_eq64(std::cos(0.0), 1.0, 0.0001);
    assert_approx_eq64(std::exp(0.0), 1.0, 0.0001);
    assert_approx_eq64(std::log(e_val), 1.0, 0.0001);
    assert_approx_eq64(std::log2(8.0), 3.0, 0.0001);
    assert_approx_eq64(std::log10(100.0), 2.0, 0.0001);
    assert_approx_eq64(std::pow(2.0, 3.0), 8.0, 0.0001);

    // 3. Rounding functions (f64)
    assert_approx_eq64(std::floor(2.7), 2.0, 0.0001);
    assert_approx_eq64(std::ceil(2.3), 3.0, 0.0001);
    assert_approx_eq64(std::round(2.6), 3.0, 0.0001);
    assert_approx_eq64(std::round(2.4), 2.0, 0.0001);
    assert_approx_eq64(std::trunc(2.9), 2.0, 0.0001);
    assert_approx_eq64(std::trunc(-2.9), -2.0, 0.0001);

    // 4. FloatOps trait method calls (f64)
    dec x = 16.0;
    assert_approx_eq64(x.sqrt(), 4.0, 0.0001);
    dec angle = 0.0;
    assert_approx_eq64(angle.sin(), 0.0, 0.0001);
    assert_approx_eq64(angle.cos(), 1.0, 0.0001);
    dec num = 3.75;
    assert_approx_eq64(num.floor(), 3.0, 0.0001);
    assert_approx_eq64(num.ceil(), 4.0, 0.0001);
    assert_approx_eq64(num.round(), 4.0, 0.0001);
    assert_approx_eq64(num.trunc(), 3.0, 0.0001);

    // 5. Direct standalone calls (f32)
    assert_approx_eq32(std::sqrtf(16.0 as f32), 4.0 as f32, 0.0001 as f32);
    assert_approx_eq32(std::sinf(0.0 as f32), 0.0 as f32, 0.0001 as f32);
    assert_approx_eq32(std::cosf(0.0 as f32), 1.0 as f32, 0.0001 as f32);
    assert_approx_eq32(std::powf(3.0 as f32, 2.0 as f32), 9.0 as f32, 0.0001 as f32);
    assert_approx_eq32(std::floorf(5.9 as f32), 5.0 as f32, 0.0001 as f32);
    assert_approx_eq32(std::ceilf(5.1 as f32), 6.0 as f32, 0.0001 as f32);

    // 6. FloatOps trait method calls (f32)
    dec f_val = 25.0 as f32;
    assert_approx_eq32(f_val.sqrt(), 5.0 as f32, 0.0001 as f32);
    dec f_round = 7.6 as f32;
    assert_approx_eq32(f_round.floor(), 7.0 as f32, 0.0001 as f32);
    assert_approx_eq32(f_round.ceil(), 8.0 as f32, 0.0001 as f32);
}
