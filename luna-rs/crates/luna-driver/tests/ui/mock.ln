import <try>;

export enum MyResult<T, E> {
    MyOk(T),
    MyErr(E),
}

export struct MyResidual<E> {
    err: E,
};

impl<T, E> std::Try for MyResult<T, E> {
    type Output = T;
    type Residual = MyResidual<E>;

    fn from_output(x: T) -> Self {
        return MyResult::MyOk(x);
    }

    fn branch(self: Self) -> std::ControlFlow<MyResidual<E>, T> {
        return match self {
            MyResult::MyOk(t) -> std::ControlFlow::Continue(t),
            MyResult::MyErr(e) -> std::ControlFlow::Break(MyResidual { err: e }),
        };
    }
}

impl<T, E> std::FromResidual<MyResidual<E> > for MyResult<T, E> {
    fn from_residual(r: MyResidual<E>) -> Self {
        return MyResult::MyErr(r.err);
    }
}
